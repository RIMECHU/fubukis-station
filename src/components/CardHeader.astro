---
/**
 * CardHeader Component
 * Header with icon and title for cards
 */

import { Icon } from 'astro-icon/components';

interface Props {
	title: string;
	icon?: 'user' | 'rss' | 'folder' | 'briefcase' | 'heart';
	href?: string;
	linkText?: string;
}

const { title, icon, href, linkText } = Astro.props;

const icons = {
	user: 'ph:user-duotone',
	rss: 'ph:rss-simple-duotone',
	folder: 'ph:folder-notch-duotone',
	briefcase: 'ph:briefcase-duotone',
	heart: 'ph:heart-duotone',
};
---

<div class="flex items-center gap-3 mb-4">
	{icon && (
		<Icon
			name={icons[icon]}
			class="w-5 h-5 text-accent flex-shrink-0 iconify"
			style="filter: drop-shadow(0 0 4px var(--color-accent))"
		/>
	)}
		<h2 class="text-lg font-semibold text-accent m-0">{title}</h2>
	{href && linkText && (
		<a href={href} class="card-header-link">{linkText} →</a>
	)}
</div>

<style>
	.card-header-link {
		margin-left: auto;
		font-size: 0.75rem;
		font-family: var(--font-mono, monospace);
		color: color-mix(in srgb, var(--color-foreground) 45%, transparent);
		text-decoration: none;
		transition: color 0.15s ease;
		flex-shrink: 0;
	}
	.card-header-link:hover {
		color: var(--color-primary);
	}
</style>
