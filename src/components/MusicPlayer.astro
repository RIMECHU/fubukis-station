---
/**
 * Cute floating pixel music widget (女性向 / soft-girly)
 * Ribbon ghost girl + pink headphones + spinning disc
 * Click = play/pause · hover = title · right-click / long-press = volume
 */
const TITLE = 'TK from 凛として時雨 - an artist';
---

<div id="music-player" class="music-player" data-playing="false">
	<button
		type="button"
		class="mp-buddy"
		id="mp-toggle"
		aria-label="Play or pause music"
		title={TITLE}
	>
		<svg class="mp-svg" viewBox="0 0 64 58" shape-rendering="crispEdges" aria-hidden="true">
			<!-- soft glow floor -->
			<ellipse class="glow" cx="32" cy="52" rx="18" ry="4" fill="#e8b4d4" opacity="0.28"/>

			<!-- vinyl disc (softer feminine) -->
			<g class="disc">
				<rect x="38" y="24" width="20" height="20" fill="#5a4a6e"/>
				<rect x="40" y="26" width="16" height="16" fill="#7a6a90"/>
				<rect x="44" y="30" width="8" height="8" fill="#e8b4d4"/>
				<rect x="46" y="32" width="4" height="4" fill="#f4f7fc"/>
				<rect x="47" y="33" width="2" height="2" fill="#c9a0dc"/>
				<rect x="41" y="27" width="3" height="1" fill="#f0c8e0" opacity="0.8"/>
			</g>

			<!-- cute feminine ghost girl -->
			<g class="buddy">
				<!-- big ribbon bow on head -->
				<rect x="18" y="6" width="2" height="2" fill="#e8b4d4"/>
				<rect x="14" y="7" width="5" height="4" fill="#f0c8e0"/>
				<rect x="23" y="7" width="5" height="4" fill="#f0c8e0"/>
				<rect x="19" y="8" width="4" height="3" fill="#c9a0dc"/>
				<rect x="20" y="9" width="2" height="2" fill="#e8eef8"/>
				<!-- ribbon tails -->
				<rect x="15" y="11" width="2" height="3" fill="#e8b4d4"/>
				<rect x="25" y="11" width="2" height="3" fill="#e8b4d4"/>

				<!-- soft round body -->
				<rect x="11" y="16" width="20" height="16" fill="#fff5fa"/>
				<rect x="13" y="14" width="16" height="2" fill="#fff5fa"/>
				<!-- frilly hem -->
				<rect x="12" y="32" width="3" height="3" fill="#fce8f2"/>
				<rect x="16" y="31" width="3" height="3" fill="#fff5fa"/>
				<rect x="20" y="32" width="3" height="3" fill="#fce8f2"/>
				<rect x="24" y="31" width="3" height="3" fill="#fff5fa"/>
				<rect x="28" y="32" width="2" height="2" fill="#fce8f2"/>

				<!-- lilac-pink headphones -->
				<rect x="9" y="17" width="3" height="7" fill="#c9a0dc"/>
				<rect x="30" y="17" width="3" height="7" fill="#c9a0dc"/>
				<rect x="11" y="14" width="20" height="3" fill="#e8b4d4"/>
				<rect x="13" y="13" width="16" height="2" fill="#f0c8e0"/>
				<!-- ear cups with heart dot -->
				<rect x="8" y="19" width="4" height="5" fill="#a878b8"/>
				<rect x="30" y="19" width="4" height="5" fill="#a878b8"/>
				<rect x="9" y="20" width="2" height="2" fill="#fff5fa"/>
				<rect x="31" y="20" width="2" height="2" fill="#fff5fa"/>

				<!-- feminine cat-eye sunglasses (rose / lilac) -->
				<rect x="18" y="20" width="4" height="2" fill="#8a6a9a"/>
				<!-- left lens (slightly upswept) -->
				<rect x="11" y="18" width="8" height="6" fill="#6a4a7a"/>
				<rect x="12" y="19" width="6" height="4" fill="#9a6aaa"/>
				<rect x="11" y="18" width="2" height="1" fill="#c9a0dc"/>
				<!-- right lens -->
				<rect x="21" y="18" width="8" height="6" fill="#6a4a7a"/>
				<rect x="22" y="19" width="6" height="4" fill="#9a6aaa"/>
				<rect x="27" y="18" width="2" height="1" fill="#c9a0dc"/>
				<!-- heart-ish shine on lenses -->
				<rect class="lens-shine" x="13" y="19" width="2" height="1" fill="#fce8f2" opacity="0.95"/>
				<rect class="lens-shine" x="14" y="20" width="1" height="1" fill="#ffffff" opacity="0.7"/>
				<rect class="lens-shine" x="23" y="19" width="2" height="1" fill="#fce8f2" opacity="0.95"/>
				<rect class="lens-shine" x="24" y="20" width="1" height="1" fill="#ffffff" opacity="0.7"/>
				<rect class="lens-shine2" x="15" y="21" width="2" height="1" fill="#e8b4d4" opacity="0.45"/>
				<rect class="lens-shine2" x="25" y="21" width="2" height="1" fill="#e8b4d4" opacity="0.45"/>
				<!-- arms -->
				<rect x="10" y="19" width="2" height="2" fill="#8a6a9a"/>
				<rect x="28" y="19" width="2" height="2" fill="#8a6a9a"/>

				<!-- soft blush -->
				<rect class="blush" x="11" y="25" width="3" height="2" fill="#f0a8c8" opacity="0.95"/>
				<rect class="blush" x="26" y="25" width="3" height="2" fill="#f0a8c8" opacity="0.95"/>
				<!-- cute smile -->
				<rect x="17" y="27" width="2" height="1" fill="#d4a0c0"/>
				<rect x="21" y="27" width="2" height="1" fill="#d4a0c0"/>
				<rect x="18" y="28" width="4" height="1" fill="#e8b4d4" opacity="0.7"/>
			</g>

			<!-- floating hearts + notes -->
			<g class="notes">
				<!-- heart -->
				<rect x="3" y="8" width="1" height="1" fill="#e8b4d4"/>
				<rect x="5" y="8" width="1" height="1" fill="#e8b4d4"/>
				<rect x="3" y="9" width="3" height="1" fill="#f0c8e0"/>
				<rect x="4" y="10" width="1" height="1" fill="#c9a0dc"/>
				<!-- note -->
				<rect x="34" y="6" width="2" height="4" fill="#c9a0dc"/>
				<rect x="36" y="5" width="3" height="2" fill="#e8b4d4"/>
			</g>
		</svg>
		<span class="mp-ring" aria-hidden="true"></span>
	</button>

	<div class="mp-tooltip" aria-hidden="true">
		<span class="mp-tip-icon">♡</span>
		<span class="mp-tooltip-text">{TITLE}</span>
	</div>

	<div class="mp-vol-wrap" id="mp-vol-wrap">
		<div class="mp-vol-pop" id="mp-vol-pop">
			<input type="range" id="mp-volume" class="mp-vol" min="0" max="100" value="15" orient="vertical" />
			<span id="vol-num" class="vol-num">15</span>
			<span class="vol-hint">♪</span>
		</div>
	</div>
</div>

<script>
	(function() {
		var TARGET_VOL = 0.15;
		var FADE_DURATION = 5000;
		var SONG_SRC = '/TK from 凛として時雨 - an artist.mp3';
		var win = window;

		if (!win.__siteAudio) {
			var a = new Audio(SONG_SRC);
			a.loop = true;
			a.volume = 0;
			win.__siteAudio = a;
			win.__siteAudioCreated = true;
		}
		var audio = win.__siteAudio;
		var created = win.__siteAudioCreated;

		function getRoot() { return document.getElementById('music-player'); }
		function getVolInput() { return document.getElementById('mp-volume'); }
		function getVolNum() { return document.getElementById('vol-num'); }
		function getVolWrap() { return document.getElementById('mp-vol-wrap'); }

		function updateVolUI(v) {
			var vi = getVolInput();
			var vn = getVolNum();
			if (vi) vi.value = String(Math.round(v * 100));
			if (vn) vn.textContent = String(Math.round(v * 100));
		}

		function updatePlayUI() {
			var root = getRoot();
			if (!root) return;
			root.setAttribute('data-playing', audio.paused ? 'false' : 'true');
		}

		updateVolUI(audio.volume);
		updatePlayUI();

		var fadingIn = false;

		function doFadeIn() {
			if (fadingIn) return;
			fadingIn = true;
			audio.volume = 0;
			updateVolUI(0);
			audio.play().then(function() {
				updatePlayUI();
				var start = performance.now();
				function fade(now) {
					var elapsed = now - start;
					var progress = Math.min(elapsed / FADE_DURATION, 1);
					var eased = 1 - Math.pow(1 - progress, 3);
					audio.volume = eased * TARGET_VOL;
					updateVolUI(audio.volume);
					if (progress < 1) requestAnimationFrame(fade);
					else fadingIn = false;
				}
				requestAnimationFrame(fade);
			}).catch(function() {
				fadingIn = false;
			});
		}

		if (created) {
			win.__siteAudioCreated = false;
			updateVolUI(0);
			audio.play().then(function() {
				updatePlayUI();
				var start = performance.now();
				function fade(now) {
					var elapsed = now - start;
					var progress = Math.min(elapsed / FADE_DURATION, 1);
					var eased = 1 - Math.pow(1 - progress, 3);
					audio.volume = eased * TARGET_VOL;
					updateVolUI(audio.volume);
					if (progress < 1) requestAnimationFrame(fade);
				}
				fadingIn = true;
				requestAnimationFrame(fade);
			}).catch(function() {
				updatePlayUI();
				var events = ['click', 'touchstart', 'keydown', 'scroll'];
				function onInteract() {
					doFadeIn();
					events.forEach(function(e) { document.removeEventListener(e, onInteract); });
				}
				events.forEach(function(e) { document.addEventListener(e, onInteract, { once: true }); });
			});
		}

		document.addEventListener('click', function(e) {
			var target = e.target;
			if (!target) return;

			if (target.closest('#mp-toggle')) {
				if (audio.paused) {
					if (audio.volume < 0.01) doFadeIn();
					else {
						audio.volume = TARGET_VOL;
						updateVolUI(audio.volume);
						audio.play().catch(function() {});
					}
				} else {
					audio.pause();
				}
				updatePlayUI();
				return;
			}

			var vw = getVolWrap();
			if (vw && !vw.contains(target) && !target.closest('#mp-toggle')) {
				vw.classList.remove('vol-open');
			}
		});

		document.addEventListener('input', function(e) {
			var target = e.target;
			if (target && target.id === 'mp-volume') {
				audio.volume = Number(target.value) / 100;
				updateVolUI(audio.volume);
			}
		});

		var longPressTimer;
		document.addEventListener('touchstart', function(e) {
			if (e.target && e.target.closest('#mp-toggle')) {
				longPressTimer = setTimeout(function() {
					var vw = getVolWrap();
					if (vw) vw.classList.toggle('vol-open');
				}, 500);
			}
		}, { passive: true });
		document.addEventListener('touchend', function() { clearTimeout(longPressTimer); });
		document.addEventListener('touchmove', function() { clearTimeout(longPressTimer); });

		document.addEventListener('contextmenu', function(e) {
			if (e.target && e.target.closest('#mp-toggle')) {
				e.preventDefault();
				var vw = getVolWrap();
				if (vw) vw.classList.toggle('vol-open');
			}
		});

		if (!win.__siteAudioListenersAttached) {
			win.__siteAudioListenersAttached = true;
			audio.addEventListener('play', updatePlayUI);
			audio.addEventListener('pause', updatePlayUI);
			audio.addEventListener('volumechange', function() { updateVolUI(audio.volume); });
		}

		document.addEventListener('astro:after-swap', function() {
			setTimeout(function() {
				updatePlayUI();
				updateVolUI(audio.volume);
			}, 0);
		});
	})();
</script>

<style>
	.music-player {
		--mist: #909ec8;
		--lilac: #c9a0dc;
		--bone: #fff5fa;
		--blush: #f0a8c8;
		--rose: #e8b4d4;
		--ink: #0a0e1a;
		position: fixed;
		bottom: 1rem;
		left: 1rem;
		z-index: 9998;
		width: 96px;
		height: 88px;
	}

	.mp-buddy {
		position: relative;
		width: 96px;
		height: 88px;
		padding: 0;
		border: none;
		background: transparent;
		cursor: pointer;
		filter: drop-shadow(0 8px 16px color-mix(in srgb, var(--rose) 32%, transparent));
		transition: transform 0.25s cubic-bezier(0.34, 1.5, 0.64, 1), filter 0.25s ease;
	}

	.mp-buddy:hover {
		transform: translateY(-5px) scale(1.06) rotate(-2deg);
		filter: drop-shadow(0 12px 24px color-mix(in srgb, var(--lilac) 40%, transparent));
	}

	.mp-buddy:active {
		transform: scale(0.94);
	}

	.mp-svg {
		width: 100%;
		height: 100%;
		display: block;
		image-rendering: pixelated;
		image-rendering: crisp-edges;
		overflow: visible;
	}

	.mp-ring {
		position: absolute;
		inset: 12% 8% 8%;
		border-radius: 50%;
		background: radial-gradient(circle, color-mix(in srgb, var(--lilac) 30%, transparent), transparent 70%);
		opacity: 0;
		pointer-events: none;
		z-index: -1;
	}

	.notes {
		opacity: 0;
	}

	.music-player[data-playing='true'] .disc {
		transform-origin: 48px 34px;
		animation: discSpin 2.8s linear infinite;
	}
	.music-player[data-playing='true'] .buddy {
		animation: buddyBob 1.2s ease-in-out infinite;
	}
	.music-player[data-playing='true'] .lens-shine {
		animation: lensFlash 1.4s ease-in-out infinite;
	}
	.music-player[data-playing='true'] .lens-shine2 {
		animation: lensFlash 1.4s ease-in-out infinite 0.35s;
	}
	.music-player[data-playing='true'] .blush {
		opacity: 1;
	}
	.music-player[data-playing='true'] .notes {
		opacity: 1;
		animation: noteFloat 1.6s ease-in-out infinite;
	}
	.music-player[data-playing='true'] .mp-ring {
		animation: ringPulse 1.8s ease-out infinite;
	}
	.music-player[data-playing='true'] .glow {
		animation: glowPulse 1.8s ease-in-out infinite;
	}

	@keyframes discSpin {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}
	@keyframes buddyBob {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-2px); }
	}
	@keyframes lensFlash {
		0%, 100% { opacity: 0.75; }
		50% { opacity: 1; }
	}
	@keyframes noteFloat {
		0%, 100% { transform: translateY(0); opacity: 0.85; }
		50% { transform: translateY(-3px); opacity: 1; }
	}
	@keyframes ringPulse {
		0% { opacity: 0.45; transform: scale(0.9); }
		100% { opacity: 0; transform: scale(1.35); }
	}
	@keyframes glowPulse {
		0%, 100% { opacity: 0.18; }
		50% { opacity: 0.35; }
	}

	@media (prefers-reduced-motion: reduce) {
		.music-player[data-playing='true'] .disc,
		.music-player[data-playing='true'] .buddy,
		.music-player[data-playing='true'] .lens-shine,
		.music-player[data-playing='true'] .lens-shine2,
		.music-player[data-playing='true'] .notes,
		.music-player[data-playing='true'] .mp-ring,
		.music-player[data-playing='true'] .glow {
			animation: none;
		}
	}

	.mp-tooltip {
		position: absolute;
		left: 100px;
		bottom: 22px;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		max-width: 230px;
		padding: 0.4rem 0.7rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--rose) 50%, var(--lilac));
		background:
			linear-gradient(165deg,
				color-mix(in srgb, var(--rose) 20%, transparent),
				color-mix(in srgb, var(--lilac) 14%, transparent) 50%,
				color-mix(in srgb, var(--ink) 78%, transparent));
		backdrop-filter: blur(12px);
		box-shadow: 0 8px 20px color-mix(in srgb, var(--rose) 22%, transparent);
		opacity: 0;
		transform: translateX(-8px);
		pointer-events: none;
		transition: opacity 0.2s ease, transform 0.2s ease;
	}
	.mp-tip-icon {
		color: var(--rose);
		font-size: 0.75rem;
		flex-shrink: 0;
	}
	.mp-tooltip-text {
		font-family: var(--font-mono, monospace);
		font-size: 0.65rem;
		color: var(--bone);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.mp-buddy:hover + .mp-tooltip,
	.music-player:focus-within .mp-tooltip {
		opacity: 1;
		transform: translateX(0);
	}

	.mp-vol-wrap {
		position: absolute;
		left: 50%;
		bottom: 100%;
		transform: translateX(-50%);
		margin-bottom: 0.35rem;
	}
	.mp-vol-pop {
		padding: 0.5rem 0.55rem 0.4rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
		background:
			linear-gradient(180deg,
				color-mix(in srgb, var(--rose) 16%, transparent),
				color-mix(in srgb, var(--ink) 88%, transparent));
		backdrop-filter: blur(12px);
		border: 1px solid color-mix(in srgb, var(--lilac) 40%, transparent);
		border-radius: 14px;
		box-shadow: 0 8px 20px color-mix(in srgb, var(--rose) 20%, transparent);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s ease;
	}
	.mp-vol-wrap.vol-open .mp-vol-pop {
		opacity: 1;
		pointer-events: auto;
	}
	.mp-vol {
		-webkit-appearance: slider-vertical;
		appearance: slider-vertical;
		width: 16px;
		height: 72px;
		cursor: pointer;
		accent-color: var(--rose);
		margin: 0;
	}
	.vol-num {
		font-size: 0.62rem;
		font-family: var(--font-mono, monospace);
		color: color-mix(in srgb, var(--bone) 78%, transparent);
	}
	.vol-hint {
		font-size: 0.75rem;
		color: var(--lilac);
	}

	@media (max-width: 640px) {
		.music-player {
			bottom: 0.8rem;
			left: 0.8rem;
			width: 84px;
			height: 78px;
		}
		.mp-buddy {
			width: 84px;
			height: 78px;
		}
		.mp-tooltip {
			left: 0;
			bottom: calc(100% + 8px);
			max-width: 200px;
		}
	}
</style>
