---
import ThemeSelector from './ThemeSelector.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { Icon } from 'astro-icon/components';
import { SITE_TITLE } from '../consts';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { defaultLang, useTranslations, getRelativeLocaleUrl } from '../i18n/config';
import type { Lang } from '../i18n/config';

type NavItem =
	| { type: 'link'; name: string; href: string }
	| { type: 'component'; component: AstroComponentFactory; class?: string };

const { lang = defaultLang } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

const localized = (path: string) => getRelativeLocaleUrl(lang, path);

// Active nav detection (trailing-slash insensitive)
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
	const h = href.replace(/\/+$/, '') || '/';
	const home = (localized('/') as string).replace(/\/+$/, '') || '/';
	if (h === home) return currentPath === h;
	return currentPath === h || currentPath.startsWith(h + '/');
};

const items = [
	{ type: 'link', name: t('common.nav.home'), href: localized('/') },
	{ type: 'link', name: t('common.nav.blog'), href: localized('/blog') },
	{ type: 'link', name: t('common.nav.friends'), href: localized('/links') },
	{ type: 'link', name: t('common.nav.about'), href: localized('/about') },
	{ type: 'component', component: LanguageSwitcher, class: 'w-full sm:w-auto sm:pl-1 language-switcher-li' },
	{ type: 'component', component: ThemeSelector, class: 'w-full sm:w-auto sm:pl-1 theme-selector-li' },
] satisfies NavItem[];
---

<nav
	class="header-nav fixed top-0 left-0 right-0 z-[50] w-full transition-transform duration-300 ease-in-out"
	data-open="false"
	data-scroll-direction="up"
>
	<div class="nav-container max-w-[1280px] mx-auto px-4 py-4 flex items-center justify-between">
		<a class="brand font-extrabold text-xl no-underline" href={localized('/')} aria-label={SITE_TITLE}>
				<span class="brand-prompt" aria-hidden="true">$</span>
				<span class="brand-name">{t('common.brand')}</span>
				<span class="brand-skull" aria-hidden="true">
					<svg viewBox="-19 -18 38 37" xmlns="http://www.w3.org/2000/svg">
						<path d="M0,-16 C-11,-16 -17,-9 -17,0 C-17,6 -14,10 -10,12 L-10,17 L-5,17 L-5,13 L0,13 L0,17 L5,17 L5,13 L10,13 L10,17 L10,12 C14,10 17,6 17,0 C17,-9 11,-16 0,-16 Z" fill="#e8eef8"/>
						<circle cx="-6" cy="0" r="4" fill="#0a0e1a"/>
						<circle cx="6" cy="0" r="4" fill="#0a0e1a"/>
						<circle cx="-7.3" cy="-1.4" r="1.3" fill="#ffffff"/>
						<circle cx="4.7" cy="-1.4" r="1.3" fill="#ffffff"/>
						<path d="M0,5.5 L-1.6,9 L1.6,9 Z" fill="#0a0e1a" opacity="0.7"/>
						<ellipse cx="-10.5" cy="6.5" rx="2.6" ry="1.5" fill="#c9a0dc" opacity="0.6"/>
						<ellipse cx="10.5" cy="6.5" rx="2.6" ry="1.5" fill="#c9a0dc" opacity="0.6"/>
					</svg>
				</span>
			</a>

		<ul
			id="primary-nav"
			class="nav-list hidden flex-col absolute left-0 right-0 top-full z-[40] p-4 gap-0 opacity-0 pointer-events-none transition-all duration-200 ease-out sm:static sm:flex sm:flex-row sm:items-center sm:gap-4 sm:p-0 sm:opacity-100 sm:pointer-events-auto sm:shadow-none sm:bg-transparent"
		>
			{items.map((item, index) => (
				<>
					{item.type === 'link' ? (
						<li class="w-full sm:w-auto">
							<a
								href={item.href}
								class:list={['nav-link', { 'nav-link-active': isActive(item.href) }]}
								aria-current={isActive(item.href) ? 'page' : undefined}
							>
								{item.name}
							</a>
						</li>
					) : (
						<li class={item.class}>
							<item.component lang={lang} />
						</li>
					)}
					{item.type === 'link' && items[index + 1]?.type === 'link' && (
						<li class="nav-separator select-none" aria-hidden="true">
							<svg class="nav-cross" viewBox="0 0 28 36" xmlns="http://www.w3.org/2000/svg">
								<!-- ornate gothic cross -->
								<path
									d="M14 2.5 L14 33.5"
									stroke="currentColor"
									stroke-width="2.4"
									stroke-linecap="round"
								/>
								<path
									d="M5 11.5 L23 11.5"
									stroke="currentColor"
									stroke-width="2.4"
									stroke-linecap="round"
								/>
								<!-- decorative tips -->
								<circle cx="14" cy="2.8" r="2.1" fill="currentColor"/>
								<circle cx="14" cy="33.2" r="2.1" fill="currentColor"/>
								<circle cx="5.2" cy="11.5" r="2.1" fill="currentColor"/>
								<circle cx="22.8" cy="11.5" r="2.1" fill="currentColor"/>
								<!-- center gem -->
								<circle cx="14" cy="11.5" r="3.1" fill="currentColor" opacity="0.95"/>
								<circle cx="14" cy="11.5" r="1.35" fill="#0a0e1a" opacity="0.55"/>
								<!-- soft lilac accent on center -->
								<circle cx="13.3" cy="10.7" r="0.7" fill="#c9a0dc" opacity="0.85"/>
							</svg>
						</li>
					)}
				</>
			))}
		</ul>

		<button
			class="mobile-menu-toggle inline-flex h-10 w-10 items-center justify-center border-2 border-[color-mix(in_srgb,var(--color-accent)_20%,transparent)] bg-[color:var(--color-background)] text-[color:var(--color-accent)] transition-colors duration-150 sm:hidden"
			data-nav-toggle
			aria-label={t('common.mobileMenu')}
			aria-expanded="false"
			aria-controls="primary-nav"
		>
			<Icon name="ph:list-duotone" class="menu-closed w-6 h-6" />
			<Icon name="ph:x-duotone" class="menu-open w-6 h-6 hidden" />
		</button>
	</div>
</nav>

<style>
	.header-nav {
		--nav-mist: #909ec8;
		--nav-lilac: #c9a0dc;
		--nav-bone: #e8eef8;
		--nav-ink: #0a0e1a;
		border-bottom: 1px solid color-mix(in srgb, var(--nav-mist) 28%, transparent);
		background:
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--nav-mist) 14%, transparent) 0%,
				color-mix(in srgb, var(--nav-lilac) 8%, transparent) 42%,
				color-mix(in srgb, var(--nav-ink) 72%, transparent) 100%
			),
			color-mix(in srgb, var(--color-background) 78%, transparent);
		backdrop-filter: blur(16px) saturate(1.25);
		-webkit-backdrop-filter: blur(16px) saturate(1.25);
		box-shadow:
			0 8px 28px color-mix(in srgb, var(--nav-ink) 35%, transparent),
			inset 0 1px 0 color-mix(in srgb, var(--nav-bone) 10%, transparent);
	}

	.header-nav[data-scroll-direction="down"] {
		transform: translateY(-100%);
	}

	.header-nav[data-scroll-direction="up"] {
		transform: translateY(0);
	}

	.header-nav a {
		color: color-mix(in srgb, var(--color-foreground) 80%, transparent);
		text-decoration: none;
	}

	.header-nav li:hover > a,
	.header-nav li:focus-within > a {
		color: var(--color-primary);
		background-color: color-mix(in srgb, var(--color-primary) 10%, transparent);
	}

	.nav-link {
		display: block;
		padding: 0.25rem 0.5rem;
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		line-height: 1.35;
		border-radius: 6px;
		color: color-mix(in srgb, var(--color-foreground) 82%, transparent);
		transition: color 150ms ease, background-color 150ms ease, filter 150ms ease;
	}

	@media (min-width: 640px) {
		.nav-link {
			padding: 0.25rem 0.55rem;
			font-size: 1.08rem;
		}
	}

	/* ── Brand: Kuromu gothic wordmark + skull ── */
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--color-foreground) !important;
	}

	.brand-prompt {
		font-family: var(--font-mono, monospace);
		font-weight: 700;
		color: var(--color-primary);
		text-shadow: 0 0 10px color-mix(in srgb, var(--color-primary) 45%, transparent);
		transition: text-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.brand:hover .brand-prompt {
		text-shadow:
			0 0 12px color-mix(in srgb, var(--color-primary) 55%, transparent),
			0 0 22px color-mix(in srgb, #c9a0dc 28%, transparent);
	}

	.brand-name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.35em;
		letter-spacing: 0.04em;
		line-height: 1;
		color: transparent;
		background-image: linear-gradient(
			185deg,
			#ffffff 10%,
			#dfe6f5 38%,
			#909ec8 72%,
			#6b7aa8 100%
		);
		background-size: 100% 140%;
		background-position: 50% 0%;
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		/* keep 2 layers always so filter interpolates smoothly */
		filter:
			drop-shadow(0 0 5px color-mix(in srgb, var(--color-primary) 32%, transparent))
			drop-shadow(0 0 14px color-mix(in srgb, #c9a0dc 0%, transparent));
		transition:
			filter 0.55s cubic-bezier(0.22, 1, 0.36, 1),
			background-position 0.55s cubic-bezier(0.22, 1, 0.36, 1),
			letter-spacing 0.55s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.brand:hover .brand-name {
		background-position: 50% 100%;
		letter-spacing: 0.055em;
		filter:
			drop-shadow(0 0 8px color-mix(in srgb, var(--color-primary) 48%, transparent))
			drop-shadow(0 0 18px color-mix(in srgb, #c9a0dc 28%, transparent));
	}

	/* ── Brand skull buddy ── */
	.brand-skull {
		display: inline-flex;
		width: 0.9em;
		margin-left: 0.08rem;
		filter: drop-shadow(0 0 6px color-mix(in srgb, var(--color-primary) 38%, transparent));
		transition: filter 0.55s cubic-bezier(0.22, 1, 0.36, 1), transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.brand-skull svg {
		width: 100%;
		height: auto;
		animation: navSkullBob 3.2s ease-in-out infinite;
	}

	@keyframes navSkullBob {
		0%, 100% { transform: translateY(0) rotate(-7deg); }
		50%      { transform: translateY(-12%) rotate(7deg); }
	}

	.brand:hover .brand-skull {
		filter:
			drop-shadow(0 0 9px color-mix(in srgb, var(--color-primary) 52%, transparent))
			drop-shadow(0 0 16px color-mix(in srgb, #c9a0dc 30%, transparent));
		transform: translateY(-1px);
	}

	/* Nav links: glow on hover */
	.header-nav li:hover > a.nav-link,
	.header-nav li:focus-within > a.nav-link {
		text-shadow: none;
		filter: drop-shadow(0 0 10px color-mix(in srgb, var(--color-primary) 55%, transparent));
	}

	/* Nav links: little jump on hover (desktop) */
	@media (min-width: 640px) {
		.nav-link:hover,
		.nav-link:focus-visible {
			animation: navLinkJump 0.78s cubic-bezier(0.34, 1.2, 0.64, 1);
		}
	}

	@keyframes navLinkJump {
		0%   { transform: translateY(0); }
		28%  { transform: translateY(-7px); }
		48%  { transform: translateY(-1px); }
		68%  { transform: translateY(-4px); }
		100% { transform: translateY(0); }
	}

	.nav-separator {
		display: none;
		align-items: center;
		justify-content: center;
		padding: 0 0.15rem;
		color: color-mix(in srgb, var(--color-primary) 78%, #e8eef8);
		user-select: none;
	}

	@media (min-width: 640px) {
		.nav-separator {
			display: inline-flex;
		}
	}

	.nav-cross {
		width: 0.95rem;
		height: 1.25rem;
		overflow: visible;
		filter: drop-shadow(0 0 6px color-mix(in srgb, var(--color-primary) 55%, transparent));
		opacity: 0.9;
		transition: opacity 0.2s ease, filter 0.2s ease, transform 0.25s ease;
	}

	.nav-list:hover .nav-cross {
		opacity: 1;
	}

	.nav-separator:hover .nav-cross {
		transform: scale(1.12) rotate(-6deg);
		filter: drop-shadow(0 0 10px color-mix(in srgb, var(--color-primary) 75%, transparent))
			drop-shadow(0 0 14px color-mix(in srgb, #c9a0dc 35%, transparent));
	}

	/* Horizon glow — mist → lilac veil under navbar */
	.header-nav::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(ellipse 55% 120% at 12% 0%, color-mix(in srgb, var(--nav-mist) 18%, transparent), transparent 70%),
			radial-gradient(ellipse 45% 100% at 88% 0%, color-mix(in srgb, var(--nav-lilac) 14%, transparent), transparent 68%);
		opacity: 0.9;
	}

	.header-nav::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 2px;
		background: linear-gradient(90deg,
			transparent 0%,
			color-mix(in srgb, var(--nav-mist) 55%, transparent) 22%,
			color-mix(in srgb, var(--nav-lilac) 70%, transparent) 50%,
			color-mix(in srgb, var(--nav-mist) 55%, transparent) 78%,
			transparent 100%);
		box-shadow: 0 0 16px color-mix(in srgb, var(--nav-lilac) 35%, transparent);
		pointer-events: none;
	}

	.nav-container {
		position: relative;
		z-index: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.brand-skull svg,
		.nav-link:hover,
		.nav-link:focus-visible {
			animation: none;
		}
	}

	/* ── Active page indicator ── */
	.nav-link {
		position: relative;
	}

	.nav-link-active {
		color: var(--color-primary);
		font-weight: 700;
		filter: drop-shadow(0 0 8px color-mix(in srgb, var(--color-primary) 40%, transparent));
	}

	@media (min-width: 640px) {
		.nav-link::after {
			content: '';
			position: absolute;
			left: 0.5rem;
			right: 0.5rem;
			bottom: -3px;
			height: 2px;
			border-radius: 2px;
			background: var(--color-primary);
			box-shadow: 0 0 8px color-mix(in srgb, var(--color-primary) 55%, transparent);
			transform: scaleX(0);
			transform-origin: left center;
			transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
		}

		.nav-link:hover::after,
		.nav-link-active::after {
			transform: scaleX(1);
		}

		.nav-link-active::after {
			transform-origin: center;
		}
	}

	@media (max-width: 639px) {
		.nav-link-active::before {
			content: '>';
			font-family: var(--font-mono, monospace);
			margin-right: 0.4rem;
			color: var(--color-primary);
		}
	}

	/* ── Mobile menu: staggered item entrance ── */
	@media (max-width: 639px) {
		.nav-list li {
			opacity: 0;
			transform: translateY(-6px);
			transition: opacity 0.25s ease, transform 0.25s ease;
		}

		[data-open='true'] .nav-list li {
			opacity: 1;
			transform: translateY(0);
		}

		[data-open='true'] .nav-list li:nth-child(1)  { transition-delay: 30ms; }
		[data-open='true'] .nav-list li:nth-child(2)  { transition-delay: 60ms; }
		[data-open='true'] .nav-list li:nth-child(3)  { transition-delay: 90ms; }
		[data-open='true'] .nav-list li:nth-child(4)  { transition-delay: 120ms; }
		[data-open='true'] .nav-list li:nth-child(5)  { transition-delay: 150ms; }
		[data-open='true'] .nav-list li:nth-child(6)  { transition-delay: 180ms; }
		[data-open='true'] .nav-list li:nth-child(7)  { transition-delay: 210ms; }
		[data-open='true'] .nav-list li:nth-child(8)  { transition-delay: 240ms; }
		[data-open='true'] .nav-list li:nth-child(9)  { transition-delay: 270ms; }
		[data-open='true'] .nav-list li:nth-child(10) { transition-delay: 300ms; }
		[data-open='true'] .nav-list li:nth-child(11) { transition-delay: 330ms; }
	}

	@media (min-width: 640px) {
		.nav-list {
			display: flex !important;
		}
	}

	.nav-list {
		max-height: calc(100vh - 4rem);
		overflow: auto;
	}

	.nav-list li {
		width: 100%;
		border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
	}

	.nav-list li:last-child {
		border-bottom: none;
	}

	/* Component li items */
	.theme-selector-li,
	.language-switcher-li {
		display: flex;
		align-items: center;
	}

	/* Mobile menu: full width */
	@media (max-width: 639px) {
		.theme-selector-li,
		.language-switcher-li {
			width: 100%;
		}

		/* Full width buttons in mobile menu */
		.theme-selector-li :global(#theme-selector-btn),
		.language-switcher-li :global(#lang-switcher-btn) {
			width: 100%;
			justify-content: flex-start;
			padding: 0.375rem 0.5rem;
		}

		/* Show labels in mobile menu */
		.theme-selector-li :global(.nav-label-mobile),
		.language-switcher-li :global(.nav-label-mobile) {
			display: inline;
		}
	}

	[data-open='true'] .nav-list {
		display: flex;
		opacity: 1;
		pointer-events: auto;
		background:
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--nav-mist) 16%, transparent),
				color-mix(in srgb, var(--nav-lilac) 10%, transparent) 40%,
				color-mix(in srgb, var(--nav-ink) 82%, transparent)
			),
			color-mix(in srgb, var(--color-background) 88%, transparent);
		backdrop-filter: blur(18px) saturate(1.2);
		-webkit-backdrop-filter: blur(18px) saturate(1.2);
		border-bottom: 1px solid color-mix(in srgb, var(--nav-mist) 30%, transparent);
		box-shadow:
			0 16px 36px color-mix(in srgb, var(--nav-ink) 45%, transparent),
			inset 0 1px 0 color-mix(in srgb, var(--nav-bone) 8%, transparent);
	}

	[data-open='true'] .menu-closed {
		display: none;
	}

	[data-open='true'] .menu-open {
		display: block;
	}

	@media (min-width: 640px) {
		.nav-list {
			max-height: none;
			overflow: visible;
		}

		.nav-list li {
			opacity: 1;
			transform: none;
			transition: none;
			width: auto;
			border-bottom: none;
		}

		[data-open='true'] .nav-list {
			background: transparent;
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
			border-bottom: none;
			box-shadow: none;
		}

		.theme-selector-li,
		.language-switcher-li {
			width: auto;
		}

		.theme-selector-li :global(.theme-selector-wrapper),
		.language-switcher-li :global(.lang-switcher-wrapper) {
			display: inline-flex;
			width: auto;
		}

		/* Reset button styles for desktop */
		.theme-selector-li :global(.nav-trigger),
		.theme-selector-li :global(#theme-selector-btn),
		.language-switcher-li :global(#lang-switcher-btn) {
			display: inline-flex;
			width: auto;
			justify-content: center;
			padding: 0.25rem 0.5rem;
			font-size: 1rem;
		}

		/* Hide text labels on desktop - show only icons */
		.theme-selector-li :global(.nav-label-mobile),
		.language-switcher-li :global(.nav-label-mobile) {
			display: none;
		}
	}

	.mobile-menu-toggle {
		position: relative;
		z-index: 60;
	}

	/* Add padding to body to prevent content from being hidden under fixed nav */
	:global(body) {
		padding-top: 4rem;
	}
</style>

<script is:inline>
	// ── Header nav: event delegation (survives ClientRouter SPA navigations) ──
	(function() {
		if (window.__navBound) return;
		window.__navBound = true;

		function getNav() { return document.querySelector('nav[data-open]'); }

		document.addEventListener('click', function(e) {
			var nav = getNav();
			if (!nav) return;

			// Hamburger toggle
			var toggleBtn = e.target.closest ? e.target.closest('[data-nav-toggle]') : null;
			if (toggleBtn) {
				var isOpen = nav.getAttribute('data-open') === 'true';
				nav.setAttribute('data-open', isOpen ? 'false' : 'true');
				toggleBtn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
				return;
			}

			// Close menu when clicking outside (mobile only)
			if (window.innerWidth >= 640) return;
			var navList = document.getElementById('primary-nav');
			var isOpenNow = nav.getAttribute('data-open') === 'true';
			if (isOpenNow && navList && !navList.contains(e.target)) {
				nav.setAttribute('data-open', 'false');
				var t = document.querySelector('[data-nav-toggle]');
				if (t) t.setAttribute('aria-expanded', 'false');
			}
		});

		// Auto-hide/show nav on scroll (re-query nav every frame)
		var lastScrollTop = 0;
		var ticking = false;
		var scrollThreshold = 100;

		window.addEventListener('scroll', function() {
			if (ticking) return;
			ticking = true;
			window.requestAnimationFrame(function() {
				var nav = getNav();
				if (nav) {
					var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
					if (scrollTop < scrollThreshold) {
						nav.setAttribute('data-scroll-direction', 'up');
					} else if (scrollTop > lastScrollTop) {
						nav.setAttribute('data-scroll-direction', 'down');
					} else {
						nav.setAttribute('data-scroll-direction', 'up');
					}
					lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
				}
				ticking = false;
			});
		});
	})();
</script>
