---
---
<div id="opening-animation" class="fixed inset-0 z-[9999] pointer-events-auto overflow-hidden select-none" style="display:none" aria-hidden="true">

    <!-- ═══════════ SCENE SVG ═══════════ -->
    <svg id="scene" class="absolute inset-0 z-10 w-full h-full"
         viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice"
         xmlns="http://www.w3.org/2000/svg">
        <defs>
            <!-- Night sky gradient -->
            <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#04040f"/>
                <stop offset="45%" stop-color="#0c0e24"/>
                <stop offset="100%" stop-color="#0d1117"/>
            </linearGradient>

            <!-- Moon disc -->
            <radialGradient id="moonGrad" cx="42%" cy="38%" r="65%">
                <stop offset="0%" stop-color="#fffef8"/>
                <stop offset="70%" stop-color="#f5f0e0"/>
                <stop offset="100%" stop-color="#e2d6bd"/>
            </radialGradient>

            <!-- Moon halo -->
            <radialGradient id="moonHalo" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#fff8e7" stop-opacity="0.55"/>
                <stop offset="45%" stop-color="#f5ecd5" stop-opacity="0.18"/>
                <stop offset="100%" stop-color="#f5ecd5" stop-opacity="0"/>
            </radialGradient>

            <!-- Moon outer glow filter -->
            <filter id="moonGlow" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur stdDeviation="26" result="blur"/>
                <feMerge>
                    <feMergeNode in="blur"/>
                    <feMergeNode in="blur"/>
                    <feMergeNode in="SourceGraphic"/>
                </feMerge>
            </filter>

            <!-- Petal blur for depth -->
            <filter id="blurFar" x="-40%" y="-40%" width="180%" height="180%">
                <feGaussianBlur stdDeviation="2.5"/>
            </filter>
            <filter id="blurNear" x="-40%" y="-40%" width="180%" height="180%">
                <feGaussianBlur stdDeviation="1"/>
            </filter>
            <filter id="blurFG" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur stdDeviation="5"/>
            </filter>

            <!-- Soft cloud / mist blur -->
            <filter id="cloudBlur" x="-40%" y="-40%" width="180%" height="180%">
                <feGaussianBlur stdDeviation="14"/>
            </filter>

            <!-- Flower glow -->
            <filter id="flowerGlow" x="-80%" y="-80%" width="260%" height="260%">
                <feGaussianBlur stdDeviation="1.6" result="fb"/>
                <feMerge>
                    <feMergeNode in="fb"/>
                    <feMergeNode in="SourceGraphic"/>
                </feMerge>
            </filter>

            <!-- Mist gradient -->
            <linearGradient id="mistGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#0d1117" stop-opacity="0"/>
                <stop offset="100%" stop-color="#0d1117" stop-opacity="0.85"/>
            </linearGradient>

            <!-- Branch gradient -->
            <linearGradient id="branchGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#261e24"/>
                <stop offset="100%" stop-color="#100c11"/>
            </linearGradient>
        </defs>

        <!-- Sky -->
        <rect width="1920" height="1080" fill="url(#skyGrad)"/>

        <!-- ── Stars (populated by JS) ── -->
        <g id="stars" fill="#ffffff"></g>

        <!-- ── Moon ── -->
        <g id="moon-group">
            <circle id="moon-halo" cx="1700" cy="240" r="320" fill="url(#moonHalo)"/>
            <circle cx="1700" cy="240" r="132" fill="url(#moonGrad)" filter="url(#moonGlow)" opacity="0.95"/>
            <!-- Craters -->
            <ellipse cx="1655" cy="205" rx="28" ry="23" fill="#e0d4ba" opacity="0.28"/>
            <ellipse cx="1725" cy="260" rx="18" ry="16" fill="#e0d4ba" opacity="0.22"/>
            <ellipse cx="1680" cy="285" rx="22" ry="13" fill="#e0d4ba" opacity="0.16"/>
            <ellipse cx="1740" cy="205" rx="10" ry="9" fill="#e0d4ba" opacity="0.2"/>
        </g>

        <!-- ── Clouds ── -->
        <g id="clouds" fill="#cdd6ff" opacity="0.05" filter="url(#cloudBlur)">
            <g style="animation: cloudDrift1 70s linear infinite;">
                <ellipse cx="500" cy="330" rx="230" ry="42"/>
                <ellipse cx="600" cy="318" rx="150" ry="36"/>
            </g>
            <g style="animation: cloudDrift2 95s linear infinite;">
                <ellipse cx="1050" cy="240" rx="200" ry="36"/>
                <ellipse cx="1140" cy="232" rx="130" ry="30"/>
            </g>
            <g style="animation: cloudDrift3 80s linear infinite;">
                <ellipse cx="300" cy="520" rx="180" ry="32"/>
            </g>
        </g>

        <!-- ── Sakura Branches (Top-Right) ── -->
        <g id="branches" fill="none" stroke="url(#branchGrad)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 1920,-10 Q 1820,60 1720,120 Q 1620,180 1520,250 Q 1440,310 1360,380"
                  stroke-width="15" opacity="0.95"/>
            <path d="M 1360,380 Q 1300,430 1240,480 Q 1200,510 1160,540"
                  stroke-width="8" opacity="0.9"/>
            <path d="M 1160,540 Q 1130,560 1100,580"
                  stroke-width="4" opacity="0.85"/>

            <path d="M 1720,120 Q 1660,90 1580,70 Q 1520,55 1460,50"
                  stroke-width="8" opacity="0.9"/>
            <path d="M 1580,70 Q 1540,55 1500,45"
                  stroke-width="4" opacity="0.85"/>

            <path d="M 1520,250 Q 1440,230 1360,220 Q 1300,215 1240,215"
                  stroke-width="6" opacity="0.85"/>
            <path d="M 1360,220 Q 1320,205 1280,190"
                  stroke-width="3" opacity="0.8"/>

            <path d="M 1440,310 Q 1360,340 1280,370 Q 1220,390 1160,400"
                  stroke-width="5" opacity="0.85"/>
            <path d="M 1280,370 Q 1240,380 1200,395"
                  stroke-width="3" opacity="0.8"/>

            <path d="M 1360,380 Q 1400,410 1440,440 Q 1460,455 1480,470"
                  stroke-width="4" opacity="0.8"/>

            <!-- Left branch -->
            <path d="M -10,50 Q 80,100 160,160 Q 220,210 280,270"
                  stroke-width="8" opacity="0.8"/>
            <path d="M 280,270 Q 320,310 350,350"
                  stroke-width="4" opacity="0.75"/>
            <path d="M 160,160 Q 200,140 240,120 Q 270,105 300,95"
                  stroke-width="4" opacity="0.75"/>
            <path d="M 220,210 Q 250,240 280,260 Q 300,270 320,280"
                  stroke-width="3" opacity="0.7"/>
        </g>

        <!-- ── Flowers on Branches ── -->
        <g id="branch-flowers" fill="#ffc2d1" opacity="0.9" filter="url(#flowerGlow)">
            <circle cx="1500" cy="45" r="4.5"/>
            <circle cx="1493" cy="42" r="3.4"/>
            <circle cx="1506" cy="48" r="2.8"/>
            <circle cx="1510" cy="40" r="4"/>
            <circle cx="1280" cy="190" r="4"/>
            <circle cx="1273" cy="188" r="3.2"/>
            <circle cx="1286" cy="193" r="2.8"/>
            <circle cx="1200" cy="395" r="3.4"/>
            <circle cx="1195" cy="392" r="2.8"/>
            <circle cx="1204" cy="398" r="2.3"/>
            <circle cx="1100" cy="580" r="3.4"/>
            <circle cx="1094" cy="575" r="2.8"/>
            <circle cx="1106" cy="583" r="2.3"/>
            <circle cx="1090" cy="570" r="4"/>
            <circle cx="1620" cy="180" r="3.4"/>
            <circle cx="1614" cy="177" r="2.8"/>
            <circle cx="1550" cy="240" r="2.8"/>
            <circle cx="1470" cy="305" r="3.4"/>
            <circle cx="1464" cy="302" r="2.3"/>
            <circle cx="1480" cy="470" r="2.8"/>
            <circle cx="1476" cy="467" r="2.3"/>
            <circle cx="300" cy="95" r="3.4"/>
            <circle cx="295" cy="92" r="2.8"/>
            <circle cx="350" cy="350" r="3.4"/>
            <circle cx="345" cy="347" r="2.8"/>
            <circle cx="354" cy="353" r="2.3"/>
            <circle cx="320" cy="280" r="2.8"/>
        </g>

        <!-- ── Mist layer (bottom) ── -->
        <rect x="0" y="700" width="1920" height="380" fill="url(#mistGrad)"/>
        <g opacity="0.05" fill="#cdd6ff" filter="url(#cloudBlur)">
            <ellipse cx="400" cy="920" rx="520" ry="55"/>
            <ellipse cx="1050" cy="970" rx="620" ry="48"/>
            <ellipse cx="1550" cy="900" rx="460" ry="52"/>
        </g>

        <!-- ── Falling Petals (dynamically added here) ── -->
        <g id="petals-group"></g>
    </svg>

    <!-- Cinematic vignette -->
    <div id="vignette" class="absolute inset-0 z-20 pointer-events-none"></div>

    <!-- ═══════════ CONTENT OVERLAY ═══════════ -->
    <div id="intro-content" class="absolute inset-0 z-30 flex flex-col items-center justify-center">
        <div class="logo-line">
            <span class="logo-prompt" aria-hidden="true">$</span>
            <h1 id="logo-text" data-value="kuromu" aria-label="kuromu"></h1>
            <span class="logo-cursor" aria-hidden="true"></span>
        </div>
        <div id="logo-underline"></div>
        <div class="mt-6 overflow-hidden">
            <span id="sub-text">吹雪降臨</span>
        </div>
    </div>

    <!-- Flash -->
    <div id="flash-overlay" class="absolute inset-0 z-50 opacity-0 pointer-events-none"></div>
</div>

<!-- ═══════════ INLINE SCRIPT (immediate check) ═══════════ -->
<script is:inline>
    try {
        const hasPlayed = window.__introPlayed;
	    const introEnabled = localStorage.getItem('intro-enabled') !== 'false';
        if (introEnabled && !hasPlayed) {
            window.__introPlayed = true;
            var el = document.getElementById('opening-animation');
            if (el) el.style.display = 'block';
            document.body.classList.add('is-animating');
        } else {
            const c = document.getElementById('opening-animation');
            if (c) c.style.display = 'none';
            document.body.classList.add('animation-triggered');
        }
    } catch (e) {}
</script>

<!-- ═══════════ MAIN ANIMATION SCRIPT ═══════════ -->
<script>
    const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&';

    // Sakura petal SVG path (teardrop/petal shape, pointing up)
    const PETAL_PATH = 'M0,-12 C-9,-12 -15,-3 -15,7 C-15,15 -7,20 0,26 C7,20 15,15 15,7 C15,-3 9,-12 0,-12Z';

    const PETAL_COLORS = [
        '#ffb7c5', '#ffd1dc', '#f8bbd0', '#ff9eb5',
        '#fce4ec', '#fff0f5', '#ffccd5', '#ffc2d1',
        '#ffe4e1', '#fde0e8', '#ffd6e0', '#ffbfd5',
    ];

    interface Petal {
        el: SVGElement;
        x: number;
        y: number;
        size: number;
        speed: number;
        drift: number;      // baseline horizontal drift (leftward, from branch side)
        swayAmp: number;
        swayFreq: number;
        swayPhase: number;
        rotation: number;
        rotSpeed: number;
        opacity: number;
        baseOpacity: number;
    }

    function startAnimation() {
        const container = document.getElementById('opening-animation');
        if (!container) return;

        if (localStorage.getItem('intro-enabled') === 'false') {
            container.remove();
            document.body.classList.remove('is-animating');
            document.body.classList.add('animation-triggered');
            return;
        }

        document.body.classList.add('is-animating');

        const scene = document.getElementById('scene') as unknown as SVGElement;
        const petalsGroup = document.getElementById('petals-group') as unknown as SVGElement;
        const starsGroup = document.getElementById('stars') as unknown as SVGElement;
        const flash = document.getElementById('flash-overlay');
        const content = document.getElementById('intro-content');
        const logoText = document.getElementById('logo-text');
        const subText = document.getElementById('sub-text');
        const underline = document.getElementById('logo-underline');

        if (!scene || !petalsGroup || !flash || !content || !logoText) return;

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const VB_W = 1920;
        const VB_H = 1080;
        const svgNS = 'http://www.w3.org/2000/svg';

        // ── Stars: randomized field with staggered twinkle ──
        if (starsGroup) {
            for (let i = 0; i < 90; i++) {
                const c = document.createElementNS(svgNS, 'circle');
                c.setAttribute('cx', String(Math.random() * VB_W));
                c.setAttribute('cy', String(Math.random() * VB_H * 0.62));
                c.setAttribute('r', (0.4 + Math.random() * 1.2).toFixed(2));
                c.setAttribute('class', 'star');
                c.setAttribute('style',
                    `--d:${(2.4 + Math.random() * 3.2).toFixed(2)}s; --dl:${(-Math.random() * 5).toFixed(2)}s; opacity:${(0.25 + Math.random() * 0.6).toFixed(2)}`);
                starsGroup.appendChild(c);
            }
        }

        // ── Petals: pre-populated full-screen field + foreground bokeh ──
        const petals: Petal[] = [];

        const spawn = (foreground: boolean) => {
            const color = PETAL_COLORS[Math.floor(Math.random() * PETAL_COLORS.length)];
            const g = document.createElementNS(svgNS, 'g');
            const path = document.createElementNS(svgNS, 'path');
            path.setAttribute('d', PETAL_PATH);
            path.setAttribute('fill', color);
            g.appendChild(path);

            let p: Petal;
            if (foreground) {
                path.setAttribute('filter', 'url(#blurFG)');
                p = {
                    el: g,
                    x: Math.random() * VB_W,
                    y: Math.random() * VB_H - 60,
                    size: 30 + Math.random() * 18,
                    speed: 190 + Math.random() * 110,
                    drift: 30 + Math.random() * 40,
                    swayAmp: 40 + Math.random() * 60,
                    swayFreq: 0.2 + Math.random() * 0.4,
                    swayPhase: Math.random() * Math.PI * 2,
                    rotation: Math.random() * 360,
                    rotSpeed: (Math.random() - 0.5) * 60,
                    opacity: 0.22 + Math.random() * 0.22,
                    baseOpacity: 0,
                };
            } else {
                const depth = Math.random();
                if (depth > 0.66) path.setAttribute('filter', 'url(#blurFar)');
                else if (depth > 0.33) path.setAttribute('filter', 'url(#blurNear)');
                const size = depth > 0.66 ? 7 + Math.random() * 8 : 10 + Math.random() * 14;
                p = {
                    el: g,
                    x: Math.random() * VB_W,
                    y: Math.random() * VB_H - 60,
                    size,
                    speed: 70 + Math.random() * 130,
                    drift: 8 + Math.random() * 24,
                    swayAmp: 18 + Math.random() * 55,
                    swayFreq: 0.25 + Math.random() * 0.65,
                    swayPhase: Math.random() * Math.PI * 2,
                    rotation: Math.random() * 360,
                    rotSpeed: (Math.random() - 0.5) * 40,
                    opacity: 0.5 + Math.random() * 0.5,
                    baseOpacity: 0,
                };
            }
            p.baseOpacity = p.opacity;
            petalsGroup.appendChild(g);
            petals.push(p);
        };

        const MID_COUNT = reduced ? 30 : 85;
        const FG_COUNT = reduced ? 0 : 7;
        for (let i = 0; i < MID_COUNT; i++) spawn(false);
        for (let i = 0; i < FG_COUNT; i++) spawn(true);

        // ── Logo: terminal typewriter reveal ──
        const finalText = logoText.dataset.value || 'kuromu';
        const letterEls: HTMLElement[] = [];
        logoText.innerHTML = '';
        finalText.split('').forEach((ch) => {
            const s = document.createElement('span');
            s.className = 'logo-letter';
            s.textContent = ch;
            logoText.appendChild(s);
            letterEls.push(s);
        });

        const TYPE_BASE = reduced ? 120 : 500;
        const TYPE_GAP = reduced ? 45 : 115;
        letterEls.forEach((s, i) => {
            const final = finalText[i];
            const appearAt = TYPE_BASE + i * TYPE_GAP;
            setTimeout(() => {
                s.classList.add('on');
                if (!reduced) {
                    // brief scramble flicker before the character lands
                    let frame = 0;
                    const flick = () => {
                        frame++;
                        if (frame < 3) {
                            s.textContent = LETTERS[Math.floor(Math.random() * LETTERS.length)].toLowerCase();
                            setTimeout(flick, 42);
                        } else {
                            s.textContent = final;
                        }
                    };
                    flick();
                }
            }, appearAt);
        });
        const typedDone = TYPE_BASE + finalText.length * TYPE_GAP;

        // ── Animation Loop ──
        let startTs: number | null = null;
        const WIND_START = reduced ? 1400 : 3200;
        const TOTAL_DUR = reduced ? 2200 : 4700;

        const loop = (ts: number) => {
            if (!startTs) startTs = ts;
            const elapsed = ts - startTs;
            const dt = 1 / 60;

            const windActive = elapsed > WIND_START;
            const windProgress = windActive ? Math.min((elapsed - WIND_START) / 1300, 1) : 0;
            const windStrength = windProgress < 0.01 ? 0 : windProgress * windProgress * 520;

            petals.forEach(p => {
                p.y += p.speed * dt;
                p.x -= p.drift * dt;
                p.x += Math.sin(ts * 0.001 * p.swayFreq + p.swayPhase) * p.swayAmp * dt;
                p.rotation += p.rotSpeed * dt;

                if (windActive) {
                    p.x += windStrength * dt;
                    p.y -= windStrength * 0.3 * dt;
                    p.rotation += windStrength * 0.08 * dt;
                    p.opacity = Math.max(0, p.opacity - 1.1 * dt);
                } else {
                    // gentle fade-in for recycled petals
                    p.opacity = Math.min(p.baseOpacity, p.opacity + 0.25 * dt);
                }

                if (!windActive && (p.y > VB_H + 60 || p.x < -80 || p.x > VB_W + 80)) {
                    p.y = -40 - Math.random() * 60;
                    p.x = Math.random() * (VB_W + 200);
                    p.opacity = 0;
                }

                p.el.setAttribute('transform',
                    `translate(${p.x.toFixed(1)}, ${p.y.toFixed(1)}) rotate(${p.rotation.toFixed(1)}) scale(${(p.size / 16).toFixed(2)})`);
                p.el.setAttribute('opacity', String(Math.max(0, +p.opacity.toFixed(3))));
            });

            if (elapsed > TOTAL_DUR) return;
            if (windActive && windProgress > 0.85 && petals.every(p => p.opacity <= 0)) return;

            requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);

        // ── Timeline ──
        (async () => {
            // Subtitle: pick a poetic phrase, animate tracking
            setTimeout(() => {
                if (subText) {
                    const msgs = ['吹雪降臨', '桜吹雪', '花吹雪', '風花', '夢幻', '雪月花'];
                    subText.innerText = msgs[Math.floor(Math.random() * msgs.length)];
                    subText.classList.add('on');
                }
            }, typedDone + 250);

            // Underline draws in
            setTimeout(() => { if (underline) underline.classList.add('on'); }, typedDone + 500);

            // Wait for wind moment
            await new Promise(r => setTimeout(r, WIND_START));

            // Reveal page
            document.body.classList.add('animation-triggered');

            // Soft theme-tinted flash
            flash.style.transition = 'opacity 0.35s ease-out';
            flash.style.opacity = '0.14';
            setTimeout(() => {
                flash.style.transition = 'opacity 1s ease-out';
                flash.style.opacity = '0';
            }, 90);

            // Scene zoom-out exit
            scene.classList.add('scene-exit');

            // Fade out logo
            content.style.transition = 'opacity 0.55s ease, transform 0.55s ease, filter 0.55s ease';
            content.style.opacity = '0';
            content.style.transform = 'scale(0.96) translateY(-12px)';
            content.style.filter = 'blur(6px)';

            // Cleanup
            setTimeout(() => {
                document.body.classList.remove('is-animating');
                container.remove();
            }, reduced ? 700 : 1400);
        })();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startAnimation);
    } else {
        startAnimation();
    }
</script>

<!-- ═══════════ STYLES ═══════════ -->
<style>
    /* ── Terminal wordmark ── */
    .logo-line {
        display: flex;
        align-items: baseline;
        gap: 0.55rem;
        font-family: var(--font-mono, monospace);
        font-size: clamp(2.1rem, 7.5vw, 5.2rem);
        font-weight: 700;
        line-height: 1.1;
    }

    .logo-prompt {
        color: var(--color-primary);
        font-weight: 700;
        text-shadow: 0 0 24px color-mix(in srgb, var(--color-primary) 45%, transparent);
    }

    #logo-text {
        margin: 0;
        display: flex;
        letter-spacing: 0.04em;
        color: var(--color-foreground);
        text-shadow: 0 0 32px color-mix(in srgb, var(--color-primary) 22%, transparent);
    }

    .logo-letter {
        display: inline-block;
        opacity: 0;
    }

    .logo-letter.on {
        opacity: 1;
    }

    /* Blinking block cursor */
    .logo-cursor {
        display: inline-block;
        width: 0.42em;
        height: 0.95em;
        margin-left: 0.08em;
        background: var(--color-primary);
        box-shadow: 0 0 18px color-mix(in srgb, var(--color-primary) 60%, transparent);
        transform: translateY(0.12em);
        animation: cursorBlink 1.05s step-end infinite;
    }

    @keyframes cursorBlink {
        0%, 55%  { opacity: 1; }
        56%, 100% { opacity: 0; }
    }

    /* Underline */
    #logo-underline {
        margin-top: 1.1rem;
        height: 2px;
        width: min(46vw, 420px);
        transform: scaleX(0);
        transform-origin: center;
        background: linear-gradient(90deg,
            transparent 0%,
            var(--color-primary) 50%,
            transparent 100%);
        box-shadow: 0 0 14px color-mix(in srgb, var(--color-primary) 65%, transparent);
        transition: transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.8s ease;
        opacity: 0.9;
    }

    #logo-underline.on {
        transform: scaleX(1);
    }

    /* Subtitle */
    #sub-text {
        display: block;
        font-family: var(--font-mono, monospace);
        font-size: clamp(0.75rem, 2vw, 1rem);
        color: var(--color-primary);
        text-transform: uppercase;
        letter-spacing: 0.35em;
        opacity: 0;
        transform: translateY(12px);
        filter: blur(6px);
        transition:
            opacity 0.9s ease,
            transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1),
            filter 0.9s ease,
            letter-spacing 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s;
    }

    #sub-text.on {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
        letter-spacing: 1.1em;
        padding-left: 1.1em; /* balance trailing tracking gap */
    }

    /* Vignette */
    #vignette {
        background: radial-gradient(ellipse at 50% 42%,
            transparent 52%,
            rgba(2, 2, 10, 0.42) 100%);
    }

    /* Theme-tinted flash */
    #flash-overlay {
        background: var(--color-primary);
    }

    /* ── Scene life ── */
    #moon-group {
        animation: moonIn 2.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    @keyframes moonIn {
        from { opacity: 0; transform: translateY(34px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    #moon-halo {
        animation: haloPulse 6s ease-in-out 2.4s infinite;
    }
    @keyframes haloPulse {
        0%, 100% { opacity: 0.75; }
        50%      { opacity: 1; }
    }

    #branches {
        transform-box: view-box;
        transform-origin: 100% 0%;
        animation: branchSway 9s ease-in-out infinite alternate;
    }
    @keyframes branchSway {
        from { transform: rotate(-0.5deg); }
        to   { transform: rotate(0.6deg); }
    }

    .star {
        animation: twinkle var(--d, 3s) ease-in-out var(--dl, 0s) infinite;
    }
    @keyframes twinkle {
        0%, 100% { opacity: 0.2; }
        50%      { opacity: 0.95; }
    }

    /* Cloud drift */
    @keyframes cloudDrift1 {
        from { transform: translateX(0); }
        to   { transform: translateX(-300px); }
    }
    @keyframes cloudDrift2 {
        from { transform: translateX(0); }
        to   { transform: translateX(-400px); }
    }
    @keyframes cloudDrift3 {
        from { transform: translateX(0); }
        to   { transform: translateX(-250px); }
    }

    /* Scene exit: push-in + dissolve */
    #scene {
        transform-origin: 50% 42%;
        transition:
            transform 1.35s cubic-bezier(0.4, 0, 0.2, 1),
            opacity 0.8s ease 0.15s,
            filter 1.2s ease;
    }
    #scene.scene-exit {
        transform: scale(1.09);
        opacity: 0;
        filter: blur(10px) brightness(1.18);
    }

    #intro-content {
        will-change: opacity, transform, filter;
    }

    @media (prefers-reduced-motion: reduce) {
        #moon-group,
        #moon-halo,
        #branches,
        .star,
        .logo-cursor {
            animation: none;
        }
    }
</style>

