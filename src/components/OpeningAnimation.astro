---
---
<div id="opening-animation" class="fixed inset-0 z-[9999] pointer-events-auto overflow-hidden select-none" style="display:none" aria-hidden="true">

    <!-- ═══════════ SCENE SVG ═══════════ -->
    <svg id="scene" class="absolute inset-0 z-10 w-full h-full"
         viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice"
         xmlns="http://www.w3.org/2000/svg">
        <defs>
            <!-- Deep night sky -->
            <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#03040c"/>
                <stop offset="50%" stop-color="#080b1c"/>
                <stop offset="100%" stop-color="#151b31"/>
            </linearGradient>

            <!-- Pale moon disc -->
            <radialGradient id="moonGrad" cx="42%" cy="38%" r="65%">
                <stop offset="0%" stop-color="#fdfefe"/>
                <stop offset="70%" stop-color="#e8eef8"/>
                <stop offset="100%" stop-color="#c9d4e8"/>
            </radialGradient>

            <!-- Moon halo (dusty blue) -->
            <radialGradient id="moonHalo" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#aebadb" stop-opacity="0.5"/>
                <stop offset="45%" stop-color="#909ec8" stop-opacity="0.16"/>
                <stop offset="100%" stop-color="#909ec8" stop-opacity="0"/>
            </radialGradient>

            <!-- Crescent carve mask -->
            <mask id="crescentMask" maskUnits="userSpaceOnUse" x="0" y="0" width="1920" height="1080">
                <rect width="1920" height="1080" fill="white"/>
                <circle cx="1662" cy="218" r="112" fill="black"/>
            </mask>

            <!-- Moon glow -->
            <filter id="moonGlow" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur stdDeviation="24" result="blur"/>
                <feMerge>
                    <feMergeNode in="blur"/>
                    <feMergeNode in="blur"/>
                    <feMergeNode in="SourceGraphic"/>
                </feMerge>
            </filter>

            <!-- Foreground wisp blur -->
            <filter id="blurFG" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur stdDeviation="6"/>
            </filter>

            <!-- Soft cloud / mist blur -->
            <filter id="cloudBlur" x="-40%" y="-40%" width="180%" height="180%">
                <feGaussianBlur stdDeviation="16"/>
            </filter>

            <!-- Ground mist gradient -->
            <linearGradient id="mistGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#151b31" stop-opacity="0"/>
                <stop offset="100%" stop-color="#10152a" stop-opacity="0.55"/>
            </linearGradient>
        </defs>

        <!-- Sky -->
        <rect width="1920" height="1080" fill="url(#skyGrad)"/>

        <!-- ── Stars (populated by JS) ── -->
        <g id="stars" fill="#dce6f7"></g>

        <!-- ── Crescent Moon ── -->
        <g id="moon-group">
            <circle id="moon-halo" cx="1700" cy="240" r="330" fill="url(#moonHalo)"/>
            <g filter="url(#moonGlow)">
                <g mask="url(#crescentMask)">
                    <circle cx="1700" cy="240" r="132" fill="url(#moonGrad)" opacity="0.95"/>
                </g>
            </g>
        </g>

        <!-- ── Drifting night clouds ── -->
        <g id="clouds" fill="#8fa0c8" opacity="0.05" filter="url(#cloudBlur)">
            <g style="animation: cloudDrift1 80s linear infinite;">
                <ellipse cx="500" cy="330" rx="240" ry="40"/>
                <ellipse cx="600" cy="318" rx="150" ry="34"/>
            </g>
            <g style="animation: cloudDrift2 105s linear infinite;">
                <ellipse cx="1080" cy="240" rx="210" ry="34"/>
                <ellipse cx="1170" cy="232" rx="130" ry="28"/>
            </g>
            <g style="animation: cloudDrift3 90s linear infinite;">
                <ellipse cx="300" cy="520" rx="190" ry="30"/>
            </g>
        </g>

        <!-- ── Hanging chains ── -->
        <g id="chain-left" class="chain" stroke="#39415a" stroke-width="5" fill="none" opacity="0.85">
            <ellipse cx="150" cy="18" rx="10" ry="16"/>
            <ellipse cx="150" cy="46" rx="10" ry="16" transform="rotate(90 150 46)"/>
            <ellipse cx="150" cy="74" rx="10" ry="16"/>
            <ellipse cx="150" cy="102" rx="10" ry="16" transform="rotate(90 150 102)"/>
            <ellipse cx="150" cy="130" rx="10" ry="16"/>
            <ellipse cx="150" cy="158" rx="10" ry="16" transform="rotate(90 150 158)"/>
            <ellipse cx="150" cy="186" rx="10" ry="16"/>
            <ellipse cx="150" cy="214" rx="10" ry="16" transform="rotate(90 150 214)"/>
        </g>
        <g id="chain-right" class="chain" stroke="#39415a" stroke-width="5" fill="none" opacity="0.7">
            <ellipse cx="1830" cy="16" rx="9" ry="14"/>
            <ellipse cx="1830" cy="41" rx="9" ry="14" transform="rotate(90 1830 41)"/>
            <ellipse cx="1830" cy="66" rx="9" ry="14"/>
            <ellipse cx="1830" cy="91" rx="9" ry="14" transform="rotate(90 1830 91)"/>
            <ellipse cx="1830" cy="116" rx="9" ry="14"/>
            <ellipse cx="1830" cy="141" rx="9" ry="14" transform="rotate(90 1830 141)"/>
        </g>

        <!-- ── Graveyard silhouette ── -->
        <g id="graveyard" fill="#05070e">
            <!-- Hill -->
            <path d="M0,990 Q420,918 900,956 Q1380,992 1920,930 L1920,1080 L0,1080 Z"/>
            <!-- Crosses -->
            <g transform="translate(300,952) rotate(-6)">
                <rect x="-6" y="-58" width="12" height="60" rx="3"/>
                <rect x="-22" y="-42" width="44" height="11" rx="3"/>
            </g>
            <g transform="translate(1620,918) rotate(5)">
                <rect x="-5" y="-48" width="10" height="50" rx="3"/>
                <rect x="-18" y="-35" width="36" height="9" rx="3"/>
            </g>
            <!-- Tombstones -->
            <path d="M520,962 L520,928 Q548,906 576,928 L576,962 Z"/>
            <path d="M1230,968 L1230,940 Q1252,922 1274,940 L1274,968 Z" transform="rotate(-4 1252 945)"/>
            <path d="M860,958 L860,932 Q880,916 900,932 L900,958 Z" transform="rotate(3 880 940)"/>
            <!-- Fence spikes (left) -->
            <g>
                <rect x="60" y="930" width="6" height="70"/>
                <rect x="96" y="926" width="6" height="74"/>
                <rect x="132" y="932" width="6" height="68"/>
                <path d="M54,934 L63,914 L72,934 Z"/>
                <path d="M90,930 L99,910 L108,930 Z"/>
                <path d="M126,936 L135,916 L144,936 Z"/>
                <rect x="54" y="948" width="96" height="6"/>
            </g>
        </g>

        <!-- ── Mist layer (bottom) ── -->
        <rect x="0" y="760" width="1920" height="320" fill="url(#mistGrad)"/>
        <g opacity="0.06" fill="#8fa0c8" filter="url(#cloudBlur)">
            <ellipse cx="400" cy="960" rx="540" ry="50"/>
            <ellipse cx="1080" cy="1000" rx="640" ry="44"/>
            <ellipse cx="1580" cy="940" rx="470" ry="48"/>
        </g>

        <!-- ── Soul wisps & skulls (dynamically added here) ── -->
        <g id="wisps-group"></g>
    </svg>

    <!-- Cinematic vignette -->
    <div id="vignette" class="absolute inset-0 z-20 pointer-events-none"></div>

    <!-- ═══════════ CONTENT OVERLAY ═══════════ -->
    <div id="intro-content" class="absolute inset-0 z-30 flex flex-col items-center justify-center">
        <div class="logo-line">
            <span class="logo-prompt" aria-hidden="true">$</span>
            <h1 id="logo-text" data-value="kuromu" aria-label="kuromu"></h1>
            <span class="logo-cursor" aria-hidden="true"></span>
        </div>
        <div id="logo-underline"></div>
        <div class="mt-6 overflow-hidden">
            <span id="sub-text">夜乃くろむ</span>
        </div>
    </div>

    <!-- Flash -->
    <div id="flash-overlay" class="absolute inset-0 z-50 opacity-0 pointer-events-none"></div>
</div>

<!-- ═══════════ INLINE SCRIPT (immediate check) ═══════════ -->
<script is:inline>
    try {
        const hasPlayed = window.__introPlayed;
	    const introEnabled = localStorage.getItem('intro-enabled') !== 'false';
        if (introEnabled && !hasPlayed) {
            window.__introPlayed = true;
            var el = document.getElementById('opening-animation');
            if (el) el.style.display = 'block';
            document.body.classList.add('is-animating');
        } else {
            const c = document.getElementById('opening-animation');
            if (c) c.style.display = 'none';
            document.body.classList.add('animation-triggered');
        }
    } catch (e) {}
</script>

<!-- ═══════════ MAIN ANIMATION SCRIPT ═══════════ -->
<script>
    const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&';

    // Cute round skull (💀 motif), pointing up
    const SKULL_HEAD = 'M0,-16 C-11,-16 -17,-9 -17,0 C-17,6 -14,10 -10,12 L-10,17 L-5,17 L-5,13 L0,13 L0,17 L5,17 L5,13 L10,13 L10,17 L10,12 C14,10 17,6 17,0 C17,-9 11,-16 0,-16 Z';

    // Kuromu's member color + bone palette
    const WISP_COLORS = [
        '#909ec8', '#aab8dd', '#7f8fb8', '#c3cfec',
        '#e8ecf5', '#9aa8d6', '#b9c6e8',
    ];
    const BONE_COLOR = '#dfe6f2';

    interface Wisp {
        el: SVGGElement;
        kind: 'wisp' | 'skull' | 'foreground';
        x: number;
        y: number;
        size: number;
        speed: number;
        drift: number;
        swayAmp: number;
        swayFreq: number;
        swayPhase: number;
        rotation: number;
        rotSpeed: number;
        opacity: number;
        baseOpacity: number;
        flickFreq: number;
    }

    function startAnimation() {
        const container = document.getElementById('opening-animation');
        if (!container) return;

        if (localStorage.getItem('intro-enabled') === 'false') {
            container.remove();
            document.body.classList.remove('is-animating');
            document.body.classList.add('animation-triggered');
            return;
        }

        document.body.classList.add('is-animating');

        const scene = document.getElementById('scene') as unknown as SVGElement;
        const wispsGroup = document.getElementById('wisps-group') as unknown as SVGGElement;
        const starsGroup = document.getElementById('stars') as unknown as SVGGElement;
        const flash = document.getElementById('flash-overlay');
        const content = document.getElementById('intro-content');
        const logoText = document.getElementById('logo-text');
        const subText = document.getElementById('sub-text');
        const underline = document.getElementById('logo-underline');

        if (!scene || !wispsGroup || !flash || !content || !logoText) return;

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const VB_W = 1920;
        const VB_H = 1080;
        const svgNS = 'http://www.w3.org/2000/svg';

        // ── Stars: randomized field with staggered twinkle ──
        if (starsGroup) {
            for (let i = 0; i < 100; i++) {
                const c = document.createElementNS(svgNS, 'circle');
                c.setAttribute('cx', String(Math.random() * VB_W));
                c.setAttribute('cy', String(Math.random() * VB_H * 0.6));
                c.setAttribute('r', (0.4 + Math.random() * 1.2).toFixed(2));
                c.setAttribute('class', 'star');
                c.setAttribute('style',
                    `--d:${(2.4 + Math.random() * 3.2).toFixed(2)}s; --dl:${(-Math.random() * 5).toFixed(2)}s; opacity:${(0.25 + Math.random() * 0.6).toFixed(2)}`);
                starsGroup.appendChild(c);
            }
        }

        // ── Soul wisps rising + floating skulls ──
        const wisps: Wisp[] = [];

        const spawnWisp = (foreground: boolean) => {
            const color = WISP_COLORS[Math.floor(Math.random() * WISP_COLORS.length)];
            const g = document.createElementNS(svgNS, 'g');
            const glow = document.createElementNS(svgNS, 'circle');
            const core = document.createElementNS(svgNS, 'circle');
            glow.setAttribute('fill', color);
            core.setAttribute('fill', color);
            g.appendChild(glow);
            g.appendChild(core);

            let p: Wisp;
            if (foreground) {
                glow.setAttribute('filter', 'url(#blurFG)');
                core.setAttribute('display', 'none');
                glow.setAttribute('r', '20');
                glow.setAttribute('opacity', '0.5');
                p = {
                    el: g, kind: 'foreground',
                    x: Math.random() * VB_W,
                    y: Math.random() * VB_H,
                    size: 16 + Math.random() * 12,
                    speed: 60 + Math.random() * 60,
                    drift: (Math.random() - 0.5) * 30,
                    swayAmp: 40 + Math.random() * 60,
                    swayFreq: 0.2 + Math.random() * 0.4,
                    swayPhase: Math.random() * Math.PI * 2,
                    rotation: 0, rotSpeed: 0,
                    opacity: 0.16 + Math.random() * 0.14,
                    baseOpacity: 0,
                    flickFreq: 0.8 + Math.random() * 1.4,
                };
            } else {
                const r = 2.2 + Math.random() * 3.4;
                glow.setAttribute('r', (r * 2.6).toFixed(1));
                glow.setAttribute('opacity', '0.22');
                core.setAttribute('r', r.toFixed(1));
                core.setAttribute('opacity', '0.95');
                p = {
                    el: g, kind: 'wisp',
                    x: Math.random() * VB_W,
                    y: Math.random() * VB_H,
                    size: r,
                    speed: 26 + Math.random() * 54,
                    drift: (Math.random() - 0.5) * 18,
                    swayAmp: 20 + Math.random() * 55,
                    swayFreq: 0.25 + Math.random() * 0.65,
                    swayPhase: Math.random() * Math.PI * 2,
                    rotation: 0, rotSpeed: 0,
                    opacity: 0.45 + Math.random() * 0.5,
                    baseOpacity: 0,
                    flickFreq: 1.2 + Math.random() * 2.4,
                };
            }
            p.baseOpacity = p.opacity;
            wispsGroup.appendChild(g);
            wisps.push(p);
        };

        const spawnSkull = () => {
            const g = document.createElementNS(svgNS, 'g');
            const head = document.createElementNS(svgNS, 'path');
            head.setAttribute('d', SKULL_HEAD);
            head.setAttribute('fill', BONE_COLOR);
            g.appendChild(head);
            // big sparkly eyes
            const eyeL = document.createElementNS(svgNS, 'circle');
            const eyeR = document.createElementNS(svgNS, 'circle');
            eyeL.setAttribute('cx', '-6'); eyeL.setAttribute('cy', '0'); eyeL.setAttribute('r', '4');
            eyeR.setAttribute('cx', '6'); eyeR.setAttribute('cy', '0'); eyeR.setAttribute('r', '4');
            eyeL.setAttribute('fill', '#0a0e1a'); eyeR.setAttribute('fill', '#0a0e1a');
            g.appendChild(eyeL);
            g.appendChild(eyeR);
            const hlL = document.createElementNS(svgNS, 'circle');
            const hlR = document.createElementNS(svgNS, 'circle');
            hlL.setAttribute('cx', '-7.3'); hlL.setAttribute('cy', '-1.4'); hlL.setAttribute('r', '1.3');
            hlR.setAttribute('cx', '4.7'); hlR.setAttribute('cy', '-1.4'); hlR.setAttribute('r', '1.3');
            hlL.setAttribute('fill', '#ffffff'); hlR.setAttribute('fill', '#ffffff');
            g.appendChild(hlL);
            g.appendChild(hlR);
            // tiny nose
            const nose = document.createElementNS(svgNS, 'path');
            nose.setAttribute('d', 'M0,5.5 L-1.6,9 L1.6,9 Z');
            nose.setAttribute('fill', '#0a0e1a');
            nose.setAttribute('opacity', '0.7');
            g.appendChild(nose);
            // blush
            const blushL = document.createElementNS(svgNS, 'ellipse');
            const blushR = document.createElementNS(svgNS, 'ellipse');
            blushL.setAttribute('cx', '-10.5'); blushL.setAttribute('cy', '6.5');
            blushR.setAttribute('cx', '10.5'); blushR.setAttribute('cy', '6.5');
            blushL.setAttribute('rx', '2.6'); blushL.setAttribute('ry', '1.5');
            blushR.setAttribute('rx', '2.6'); blushR.setAttribute('ry', '1.5');
            blushL.setAttribute('fill', '#c9a0dc'); blushR.setAttribute('fill', '#c9a0dc');
            blushL.setAttribute('opacity', '0.6'); blushR.setAttribute('opacity', '0.6');
            g.appendChild(blushL);
            g.appendChild(blushR);

            const p: Wisp = {
                el: g, kind: 'skull',
                x: Math.random() * VB_W,
                y: Math.random() * VB_H,
                size: 9 + Math.random() * 7,
                speed: 14 + Math.random() * 22,
                drift: (Math.random() - 0.5) * 12,
                swayAmp: 26 + Math.random() * 40,
                swayFreq: 0.18 + Math.random() * 0.3,
                swayPhase: Math.random() * Math.PI * 2,
                rotation: (Math.random() - 0.5) * 24,
                rotSpeed: (Math.random() - 0.5) * 12,
                opacity: 0.4 + Math.random() * 0.35,
                baseOpacity: 0,
                flickFreq: 0,
            };
            p.baseOpacity = p.opacity;
            wispsGroup.appendChild(g);
            wisps.push(p);
        };

        const WISP_COUNT = reduced ? 26 : 64;
        const FG_COUNT = reduced ? 0 : 6;
        const SKULL_COUNT = reduced ? 3 : 8;
        for (let i = 0; i < WISP_COUNT; i++) spawnWisp(false);
        for (let i = 0; i < FG_COUNT; i++) spawnWisp(true);
        for (let i = 0; i < SKULL_COUNT; i++) spawnSkull();

        // ── Logo: terminal typewriter reveal ──
        const finalText = logoText.dataset.value || 'kuromu';
        const letterEls: HTMLElement[] = [];
        logoText.innerHTML = '';
        finalText.split('').forEach((ch) => {
            const s = document.createElement('span');
            s.className = 'logo-letter';
            s.textContent = ch;
            logoText.appendChild(s);
            letterEls.push(s);
        });

        const TYPE_BASE = reduced ? 120 : 500;
        const TYPE_GAP = reduced ? 45 : 115;
        letterEls.forEach((s, i) => {
            const final = finalText[i];
            const appearAt = TYPE_BASE + i * TYPE_GAP;
            setTimeout(() => {
                s.classList.add('on');
                if (!reduced) {
                    // brief scramble flicker before the character lands
                    let frame = 0;
                    const flick = () => {
                        frame++;
                        if (frame < 3) {
                            s.textContent = LETTERS[Math.floor(Math.random() * LETTERS.length)].toLowerCase();
                            setTimeout(flick, 42);
                        } else {
                            s.textContent = final;
                        }
                    };
                    flick();
                }
            }, appearAt);
        });
        const typedDone = TYPE_BASE + finalText.length * TYPE_GAP;

        // ── Animation Loop ──
        let startTs: number | null = null;
        const RUSH_START = reduced ? 1400 : 3200;
        const TOTAL_DUR = reduced ? 2200 : 4700;

        const loop = (ts: number) => {
            if (!startTs) startTs = ts;
            const elapsed = ts - startTs;
            const dt = 1 / 60;

            const rushActive = elapsed > RUSH_START;
            const rushProgress = rushActive ? Math.min((elapsed - RUSH_START) / 1300, 1) : 0;
            const rushStrength = rushProgress < 0.01 ? 0 : rushProgress * rushProgress * 560;

            wisps.forEach(p => {
                // Souls rise
                p.y -= p.speed * dt;
                p.x += p.drift * dt;
                p.x += Math.sin(ts * 0.001 * p.swayFreq + p.swayPhase) * p.swayAmp * dt;
                p.rotation += p.rotSpeed * dt;

                if (rushActive) {
                    // Soul rush: everything streaks upward and fades
                    p.y -= rushStrength * dt;
                    p.x += rushStrength * 0.12 * dt;
                    p.rotation += rushStrength * 0.02 * dt;
                    p.opacity = Math.max(0, p.opacity - 1.1 * dt);
                } else {
                    // gentle fade-in for recycled wisps
                    p.opacity = Math.min(p.baseOpacity, p.opacity + 0.25 * dt);
                }

                if (!rushActive && (p.y < -60 || p.x < -80 || p.x > VB_W + 80)) {
                    p.y = VB_H + 40 + Math.random() * 60;
                    p.x = Math.random() * VB_W;
                    p.opacity = 0;
                }

                // Soul-fire flicker
                let alpha = p.opacity;
                if (p.kind === 'wisp' && !rushActive) {
                    alpha = p.opacity * (0.72 + 0.28 * Math.sin(ts * 0.001 * p.flickFreq + p.swayPhase * 3));
                }

                // wisps are drawn at true size; skulls/fg need unit scaling
                const scale = p.kind === 'wisp' ? 1 : p.kind === 'foreground' ? (p.size / 20) : (p.size / 16);
                p.el.setAttribute('transform',
                    `translate(${p.x.toFixed(1)}, ${p.y.toFixed(1)}) rotate(${p.rotation.toFixed(1)}) scale(${scale.toFixed(2)})`);
                p.el.setAttribute('opacity', String(Math.max(0, +alpha.toFixed(3))));
            });

            if (elapsed > TOTAL_DUR) return;
            if (rushActive && rushProgress > 0.85 && wisps.every(p => p.opacity <= 0)) return;

            requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);

        // ── Timeline ──
        (async () => {
            // Subtitle: night & bone phrases
            setTimeout(() => {
                if (subText) {
                    const msgs = ['夜乃くろむ', 'ほね組', '夜の帳', '骨の花', '月下の誓い', '夜更かし'];
                    subText.innerText = msgs[Math.floor(Math.random() * msgs.length)];
                    subText.classList.add('on');
                }
            }, typedDone + 250);

            // Underline draws in
            setTimeout(() => { if (underline) underline.classList.add('on'); }, typedDone + 500);

            // Wait for the soul-rush moment
            await new Promise(r => setTimeout(r, RUSH_START));

            // Reveal page
            document.body.classList.add('animation-triggered');

            // Soft moon-blue flash
            flash.style.transition = 'opacity 0.35s ease-out';
            flash.style.opacity = '0.14';
            setTimeout(() => {
                flash.style.transition = 'opacity 1s ease-out';
                flash.style.opacity = '0';
            }, 90);

            // Scene zoom-out exit
            scene.classList.add('scene-exit');

            // Fade out logo
            content.style.transition = 'opacity 0.55s ease, transform 0.55s ease, filter 0.55s ease';
            content.style.opacity = '0';
            content.style.transform = 'scale(0.96) translateY(-12px)';
            content.style.filter = 'blur(6px)';

            // Cleanup
            setTimeout(() => {
                document.body.classList.remove('is-animating');
                container.remove();
            }, reduced ? 700 : 1400);
        })();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startAnimation);
    } else {
        startAnimation();
    }
</script>

<!-- ═══════════ STYLES ═══════════ -->
<style>
    /* ── Terminal wordmark ── */
    .logo-line {
        display: flex;
        align-items: baseline;
        gap: 0.55rem;
        font-family: var(--font-mono, monospace);
        font-size: clamp(2.1rem, 7.5vw, 5.2rem);
        font-weight: 700;
        line-height: 1.1;
    }

    .logo-prompt {
        color: #909ec8;
        font-weight: 700;
        text-shadow: 0 0 24px rgba(144, 158, 200, 0.45);
    }

    #logo-text {
        margin: 0;
        display: flex;
        letter-spacing: 0.04em;
        color: var(--color-foreground);
        text-shadow: 0 0 32px rgba(144, 158, 200, 0.25);
    }

    .logo-letter {
        display: inline-block;
        opacity: 0;
    }

    .logo-letter.on {
        opacity: 1;
    }

    /* Blinking block cursor */
    .logo-cursor {
        display: inline-block;
        width: 0.42em;
        height: 0.95em;
        margin-left: 0.08em;
        background: #909ec8;
        box-shadow: 0 0 18px rgba(144, 158, 200, 0.6);
        transform: translateY(0.12em);
        animation: cursorBlink 1.05s step-end infinite;
    }

    @keyframes cursorBlink {
        0%, 55%  { opacity: 1; }
        56%, 100% { opacity: 0; }
    }

    /* Underline */
    #logo-underline {
        margin-top: 1.1rem;
        height: 2px;
        width: min(46vw, 420px);
        transform: scaleX(0);
        transform-origin: center;
        background: linear-gradient(90deg,
            transparent 0%,
            #909ec8 50%,
            transparent 100%);
        box-shadow: 0 0 14px rgba(144, 158, 200, 0.65);
        transition: transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.8s ease;
        opacity: 0.9;
    }

    #logo-underline.on {
        transform: scaleX(1);
    }

    /* Subtitle */
    #sub-text {
        display: block;
        font-family: var(--font-mono, monospace);
        font-size: clamp(0.75rem, 2vw, 1rem);
        color: #aab8dd;
        letter-spacing: 0.35em;
        opacity: 0;
        transform: translateY(12px);
        filter: blur(6px);
        transition:
            opacity 0.9s ease,
            transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1),
            filter 0.9s ease,
            letter-spacing 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s;
    }

    #sub-text.on {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
        letter-spacing: 1.1em;
        padding-left: 1.1em; /* balance trailing tracking gap */
    }

    /* Vignette */
    #vignette {
        background: radial-gradient(ellipse at 50% 42%,
            transparent 52%,
            rgba(1, 2, 8, 0.45) 100%);
    }

    /* Moon-blue flash */
    #flash-overlay {
        background: #909ec8;
    }

    /* ── Scene life ── */
    #moon-group {
        animation: moonIn 2.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    @keyframes moonIn {
        from { opacity: 0; transform: translateY(34px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    #moon-halo {
        animation: haloPulse 6s ease-in-out 2.4s infinite;
    }
    @keyframes haloPulse {
        0%, 100% { opacity: 0.7; }
        50%      { opacity: 1; }
    }

    /* Chains sway gently from their anchor points */
    .chain {
        transform-box: view-box;
    }
    #chain-left {
        transform-origin: 150px 0px;
        animation: chainSway 7.5s ease-in-out infinite alternate;
    }
    #chain-right {
        transform-origin: 1830px 0px;
        animation: chainSway 9s ease-in-out -3s infinite alternate-reverse;
    }
    @keyframes chainSway {
        from { transform: rotate(-2.4deg); }
        to   { transform: rotate(2.6deg); }
    }

    /* Graveyard rises into view */
    #graveyard {
        animation: graveIn 2.8s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    @keyframes graveIn {
        from { opacity: 0; transform: translateY(46px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .star {
        animation: twinkle var(--d, 3s) ease-in-out var(--dl, 0s) infinite;
    }
    @keyframes twinkle {
        0%, 100% { opacity: 0.2; }
        50%      { opacity: 0.95; }
    }

    /* Cloud drift */
    @keyframes cloudDrift1 {
        from { transform: translateX(0); }
        to   { transform: translateX(-300px); }
    }
    @keyframes cloudDrift2 {
        from { transform: translateX(0); }
        to   { transform: translateX(-400px); }
    }
    @keyframes cloudDrift3 {
        from { transform: translateX(0); }
        to   { transform: translateX(-250px); }
    }

    /* Scene exit: push-in + dissolve */
    #scene {
        transform-origin: 50% 42%;
        transition:
            transform 1.35s cubic-bezier(0.4, 0, 0.2, 1),
            opacity 0.8s ease 0.15s,
            filter 1.2s ease;
    }
    #scene.scene-exit {
        transform: scale(1.09);
        opacity: 0;
        filter: blur(10px) brightness(1.18);
    }

    #intro-content {
        will-change: opacity, transform, filter;
    }

    @media (prefers-reduced-motion: reduce) {
        #moon-group,
        #moon-halo,
        #graveyard,
        .star,
        .chain,
        .logo-cursor {
            animation: none;
        }
    }
</style>

