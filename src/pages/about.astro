---
import Layout from '../layouts/BlogPost.astro';
import { defaultLang, resolveLang, type Lang, useTranslations } from '../i18n/config';
import { AVATAR_URL } from '../consts';
import TermSkulls from '../components/TermSkulls.astro';
import NightDoodles from '../components/NightDoodles.astro';

const { lang: langProp } = Astro.props as { lang?: Lang };
const lang = langProp ?? resolveLang(Astro.url.pathname) ?? defaultLang;
const t = useTranslations(lang);

const content = {
    en: {
        description: 'About me',
        terminalTitle: 'who am i',
        terminalLines: [
            { prompt: 'who am i', output: 'Kuromu' },
            { prompt: 'identity', output: 'Guitar Player' },
            { prompt: 'open github', output: 'github.com/RIMECHU' },
            { prompt: 'mail', output: 'fffreol999@gmail.com' },
        ],
        timelineTitle: 'Milestones',
        timeline: [] as { time: string; desc: string }[],
        doingTitle: 'What I do',
        doing: [] as string[],
        skillsTitle: 'Skills',
        skills: [] as string[],
        contactTitle: 'Contact',
        contact: [] as { label: string; value: string; href: string }[],
    },
    zh: {
        description: '关于我',
        terminalTitle: 'who am i',
        terminalLines: [
            { prompt: 'who am i', output: '库洛姆' },
            { prompt: 'identity', output: '吉他手' },
            { prompt: 'open github', output: 'github.com/RIMECHU' },
            { prompt: 'mail', output: 'fffreol999@gmail.com' },
        ],
        timelineTitle: '里程碑',
        timeline: [] as { time: string; desc: string }[],
        doingTitle: '正在做的事',
        doing: [] as string[],
        skillsTitle: '技能',
        skills: [] as string[],
        contactTitle: '联系方式',
        contact: [] as { label: string; value: string; href: string }[],
    },
} as const;

const d = content[lang] ?? content[defaultLang];
---

<Layout title={t('about.title')} description={d.description} showTitle={false} showBackLink={false} lang={lang}>
    <NightDoodles />
    <div class="shell">
        <!-- ── Hero ── -->
        <div class="hero">
            <img
                src={AVATAR_URL}
                alt="avatar"
                class="avatar"
                width="120"
                height="120"
                loading="lazy"
                decoding="async"
            />
            <h1 class="name">Kuromu</h1>
            <p class="tagline">{d.terminalLines[1]?.output}</p>
        </div>

        <!-- ── Terminal ── -->
        <div class="terminal">
            <div class="term-bar">
                <TermSkulls />
                <span class="term-label">{d.terminalTitle}</span>
            </div>
            <div class="term-body">
                {d.terminalLines.map(({ prompt, output }) => (
                    <div class="term-row">
                        <span class="term-prompt">$ {prompt}</span>
                        {output && <span class="term-out">{output}</span>}
                    </div>
                ))}
                <span class="cursor"></span>
            </div>
        </div>

        <!-- ── Sections (only render if data exists) ── -->
        {d.timeline.length > 0 && (
            <section class="card">
                <h2>{d.timelineTitle}</h2>
                <ul class="timeline">
                    {d.timeline.map(item => (
                        <li><em>{item.time}</em> — {item.desc}</li>
                    ))}
                </ul>
            </section>
        )}

        <div class="grid-2">
            {d.doing.length > 0 && (
                <div class="card">
                    <h2>{d.doingTitle}</h2>
                    <ul class="list">
                        {d.doing.map(item => (<li>{item}</li>))}
                    </ul>
                </div>
            )}
            {d.skills.length > 0 && (
                <div class="card">
                    <h2>{d.skillsTitle}</h2>
                    <ul class="pills">
                        {d.skills.map(item => (<li>{item}</li>))}
                    </ul>
                </div>
            )}
        </div>

        {d.contact.length > 0 && (
            <div class="contact-row">
                {d.contact.map(item => (
                    <a href={item.href} target="_blank" rel="noopener noreferrer">{item.value}</a>
                ))}
            </div>
        )}
    </div>
</Layout>

<style>
    .shell {
        max-width: 640px;
        margin: 0 auto;
        padding: 4rem 1rem 3rem;
        position: relative;
        z-index: 1;
    }

    /* ── Hero ── */
    .hero {
        text-align: center;
        margin-bottom: 2rem;
    }
    .avatar {
        width: 120px;
        height: 120px;
        border-radius: 999px;
        border: 2.5px solid color-mix(in srgb, #aab8dd 85%, transparent);
        outline: 2px dashed color-mix(in srgb, #c9a0dc 70%, transparent);
        outline-offset: 5px;
        box-shadow:
            0 0 28px color-mix(in srgb, #909ec8 48%, transparent),
            0 0 52px color-mix(in srgb, #c9a0dc 32%, transparent);
        object-fit: cover;
    }
    .name {
        margin: 1.1rem 0 0.25rem;
        font-size: 1.9rem;
        font-weight: 700;
        font-family: var(--font-display);
        letter-spacing: 0.04em;
        color: transparent;
        background-image: linear-gradient(185deg, #ffffff 0%, #e8eef8 28%, #aab8dd 58%, #c9a0dc 100%);
        -webkit-background-clip: text;
        background-clip: text;
        filter: drop-shadow(0 0 14px rgba(144, 158, 200, 0.65));
    }
    .tagline {
        margin: 0;
        font-size: 1rem;
        font-family: var(--font-display);
        letter-spacing: 0.06em;
        color: color-mix(in srgb, #c3cfec 82%, #c9a0dc);
        text-shadow: 0 0 10px rgba(144, 158, 200, 0.25);
    }

    /* ── Terminal (Kuromu mist-blue + lilac night chrome) ── */
    .terminal {
        border: 1px solid color-mix(in srgb, #909ec8 48%, transparent);
        border-radius: 14px;
        overflow: hidden;
        font-family: var(--font-mono, monospace);
        font-size: 0.88rem;
        margin-bottom: 2rem;
        background:
            linear-gradient(165deg,
                color-mix(in srgb, #909ec8 16%, transparent),
                color-mix(in srgb, #c9a0dc 10%, transparent) 48%,
                color-mix(in srgb, var(--color-background) 88%, transparent));
        box-shadow:
            0 4px 24px color-mix(in srgb, #909ec8 22%, transparent),
            0 0 32px color-mix(in srgb, #c9a0dc 12%, transparent),
            0 0 0 1px color-mix(in srgb, #c9a0dc 16%, transparent) inset,
            inset 0 1px 0 color-mix(in srgb, #e8eef8 14%, transparent);
        transition:
            border-color 0.25s ease,
            box-shadow 0.25s ease,
            transform 0.25s ease;
    }
    .terminal:hover {
        border-color: color-mix(in srgb, #c3cfec 70%, #c9a0dc);
        box-shadow:
            0 10px 36px color-mix(in srgb, #909ec8 30%, transparent),
            0 0 40px color-mix(in srgb, #c9a0dc 22%, transparent),
            inset 0 1px 0 color-mix(in srgb, #e8eef8 18%, transparent);
        transform: translateY(-2px);
    }
    .term-bar {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.45rem 0.75rem;
        background: linear-gradient(90deg,
            color-mix(in srgb, #909ec8 28%, transparent),
            color-mix(in srgb, #c9a0dc 20%, transparent));
        border-bottom: 1px solid color-mix(in srgb, #909ec8 40%, transparent);
    }
    .term-label {
        margin-left: auto;
        font-size: 0.72rem;
        font-family: var(--font-display);
        letter-spacing: 0.08em;
        color: color-mix(in srgb, #e8eef8 88%, #c9a0dc);
        text-shadow: 0 0 10px rgba(144, 158, 200, 0.35);
        text-transform: none;
    }
    /* 月相感三骷髅由 TermSkulls 组件提供 */

    .term-body {
        padding: 0.9rem 1rem;
        display: grid;
        gap: 0.4rem;
        background: linear-gradient(180deg,
            color-mix(in srgb, #909ec8 12%, transparent),
            color-mix(in srgb, #c9a0dc 6%, transparent) 38%,
            color-mix(in srgb, var(--color-background) 92%, transparent) 72%);
    }
    .term-row {
        display: grid;
        gap: 0.15rem;
    }
    .term-prompt {
        color: #c3cfec;
        font-weight: 600;
        text-shadow: 0 0 12px rgba(144, 158, 200, 0.55);
    }
    .term-out {
        color: color-mix(in srgb, #e8eef8 88%, transparent);
        padding-left: 0.5rem;
        border-left: 2px dashed color-mix(in srgb, #c9a0dc 65%, #909ec8);
    }
    .cursor {
        display: inline-block;
        width: 0.6em;
        height: 1.1em;
        background: var(--color-primary);
        animation: blink 1s step-end infinite;
        margin-top: 0.3rem;
    }
    @keyframes blink { 50% { opacity: 0; } }

    /* ── Cards ── */
    .card {
        border: 1px solid color-mix(in srgb, #909ec8 32%, transparent);
        border-radius: 14px;
        padding: 1.25rem;
        background: color-mix(in srgb, #909ec8 5%, transparent);
        box-shadow:
            0 2px 16px color-mix(in srgb, #909ec8 10%, transparent),
            inset 0 1px 0 color-mix(in srgb, #e8eef8 8%, transparent);
        margin-bottom: 1rem;
        transition:
            border-color 0.25s ease,
            box-shadow 0.25s ease;
    }
    .card:hover {
        border-color: color-mix(in srgb, #909ec8 52%, transparent);
        box-shadow:
            0 6px 28px color-mix(in srgb, #909ec8 16%, transparent),
            0 0 24px color-mix(in srgb, #c9a0dc 10%, transparent),
            inset 0 1px 0 color-mix(in srgb, #e8eef8 12%, transparent);
    }
	.card h2 {
		margin: 0 0 0.75rem;
		font-size: 1.05rem;
		font-weight: 700;
		font-family: var(--font-display);
		color: color-mix(in srgb, #c3cfec 88%, #c9a0dc);
		letter-spacing: 0.06em;
		text-transform: none;
		text-shadow: 0 0 12px rgba(144, 158, 200, 0.35);
	}

    .grid-2 {
        display: grid;
        gap: 1rem;
    }
    .grid-2 > .card { margin-bottom: 0; }
    @media (min-width: 640px) {
        .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    /* ── Lists ── */
    .timeline {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.5rem;
        font-size: 0.93rem;
    }
    .timeline em {
        font-style: normal;
        color: var(--color-primary-light);
        font-weight: 600;
    }
    .list {
        padding-left: 1.2rem;
        margin: 0;
        display: grid;
        gap: 0.4rem;
        font-size: 0.93rem;
    }
    .pills {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }
    .pills li {
        padding: 0.22rem 0.6rem;
        border: 1px solid color-mix(in srgb, #909ec8 32%, transparent);
        background: color-mix(in srgb, #909ec8 6%, transparent);
        border-radius: 999px;
        font-size: 0.84rem;
        color: color-mix(in srgb, #e8eef8 85%, transparent);
    }

    /* ── Contact ── */
    .contact-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.5rem;
        justify-content: center;
    }
    .contact-row a {
        padding: 0.4rem 0.9rem;
        border: 1px solid color-mix(in srgb, #909ec8 42%, transparent);
        border-radius: 999px;
        color: #e8eef8;
        background: color-mix(in srgb, #909ec8 8%, transparent);
        text-decoration: none;
        font-size: 0.9rem;
        transition: border-color 0.2s, background 0.2s, box-shadow 0.2s, transform 0.2s;
    }
    .contact-row a:hover {
        border-color: color-mix(in srgb, #c3cfec 70%, #c9a0dc);
        background: color-mix(in srgb, #909ec8 14%, transparent);
        box-shadow: 0 0 18px color-mix(in srgb, #909ec8 30%, transparent);
        transform: translateY(-1px);
    }
</style>
